---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  details: { title: string; text: string }[];
  faqs?: { question: string; answer: string }[];
}

const { title, description, details, icon, faqs } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": title,
  "description": description,
  "provider": {
    "@type": "Person",
    "name": "Roberto Pérez Salazar"
  }
};
---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Navbar />
  <main class="pt-32">
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center gap-12">
          <div class="md:w-2/3">
            <div class="text-6xl mb-8">{icon}</div>
            <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-6">{title}</h1>
            <p class="text-xl text-slate-600 leading-relaxed mb-8">
              {description}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-20">
          {details.map((detail) => (
            <div class="p-8 bg-slate-50 rounded-3xl border border-slate-100">
              <h3 class="text-2xl font-bold text-slate-900 mb-4">{detail.title}</h3>
              <p class="text-slate-600 leading-relaxed">{detail.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {faqs && faqs.length > 0 && (
      <section class="py-20 bg-slate-50 border-t border-b border-slate-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <span class="px-4 py-1.5 text-xs font-bold bg-blue-100 text-blue-700 rounded-full uppercase tracking-wider">Consultas Comunes</span>
            <h2 class="text-3xl font-bold text-slate-900 mt-4">Preguntas Frecuentes y Soluciones</h2>
          </div>
          <div class="space-y-6">
            {faqs.map((faq) => (
              <div class="p-8 bg-white rounded-3xl border border-slate-100 shadow-sm">
                <h4 class="text-xl font-bold text-slate-900 mb-4 flex items-start gap-3">
                  <span class="text-blue-600">💬</span>
                  <span>{faq.question}</span>
                </h4>
                <div class="text-slate-600 leading-relaxed pl-8 text-sm md:text-base whitespace-pre-line">
                  {faq.answer}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <Contact />
  </main>
  <Footer />
</Layout>
