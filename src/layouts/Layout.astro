---
import '../styles/global.css'
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Roberto Pérez Salazar | Arquitecto de Sistemas de Crecimiento con IA & Marketing Operations",
	description = "Roberto Pérez Salazar - Arquitecto de Sistemas de Crecimiento con Inteligencia Artificial, Technical SEO, GEO/AEO, Marketing Operations y Analytics."
} = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Roberto Pérez Salazar",
				"jobTitle": "Arquitecto de Sistemas de Crecimiento con IA & Marketing Operations",
				"url": "https://robertoperez.com",
				"sameAs": [
					"https://www.linkedin.com/in/roberto88/",
					"https://www.youtube.com/@recursosparaemprendedores88"
				]
			}
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-white text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-900">
		<slot />
		<CookieBanner />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}
</style>
