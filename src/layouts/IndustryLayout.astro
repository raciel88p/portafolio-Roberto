---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

interface Props {
  industry: string;
  description: string;
  icon: string;
  details: { title: string; text: string }[];
}

const { industry, description, details, icon } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Especialista SEO para ${industry}`,
  "description": description,
  "provider": {
    "@type": "Person",
    "name": "Roberto Pérez Salazar"
  },
  "areaServed": industry
};
---

<Layout title={`Consultoría SEO para ${industry} | Roberto Pérez`}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Navbar />
  <main class="pt-32">
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center gap-12">
          <div class="md:w-2/3">
            <div class="text-6xl mb-8">{icon}</div>
            <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-6">SEO para {industry}</h1>
            <p class="text-xl text-slate-600 leading-relaxed mb-8">
              {description}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-20">
          {details.map((detail) => (
            <div class="p-8 bg-slate-50 rounded-3xl border border-slate-100">
              <h3 class="text-2xl font-bold text-slate-900 mb-4">{detail.title}</h3>
              <p class="text-slate-600 leading-relaxed">{detail.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-8">¿Por qué elegir un consultor especializado en {industry}?</h2>
            <p class="text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
                Cada industria tiene sus propias reglas de juego, palabras clave específicas y comportamientos de usuario únicos. Mi enfoque se centra en entender profundamente el ecosistema de {industry} para aplicar estrategias que no solo atraigan tráfico, sino que generen conversiones reales.
            </p>
        </div>
    </section>

    <Contact />
  </main>
  <Footer />
</Layout>
