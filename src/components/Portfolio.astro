---
const projects = [
  {
    title: "GolabsTech",
    description: "Caso de Estudio SEO y GEO Consultant. Estrategia de posicionamiento global y optimización de visibilidad local.",
    tag: "SEO & GEO",
    image: "https://via.placeholder.com/600x400"
  },
  {
    title: "Mj estética Wellness Center",
    description: "Caso de Ai growth Engineer. Implementación de sistemas de IA para automatizar la adquisición de pacientes y escalar el centro.",
    tag: "AI Growth",
    image: "https://via.placeholder.com/600x400"
  },
  {
    title: "IngeniaCr",
    description: "Caso de Estudio de SEM y Web Analytics. Optimización de campañas pagas y modelado de datos para toma de decisiones estratégicas.",
    tag: "SEM & Analytics",
    image: "https://via.placeholder.com/600x400"
  },
  {
    title: "Ferretería EPA",
    description: "Consultoría estratégica para el gigante del retail en construcción. Optimización de arquitectura web y SEO técnico.",
    tag: "Consultoría SEO",
    image: "https://via.placeholder.com/600x400"
  },
  {
    title: "Instituto Nacional de Seguros",
    description: "Estrategia integral de visibilidad orgánica para la principal aseguradora de la región.",
    tag: "Consultor SEO",
    image: "https://via.placeholder.com/600x400"
  },
  {
    title: "Pymes de Costa Rica",
    description: "Programa de capacitación y asesoría SEO para el fortalecimiento del ecosistema emprendedor costarricense.",
    tag: "Capacitación",
    image: "https://via.placeholder.com/600x400"
  },
  {
    title: "Consultor SEO Personal",
    description: "Mentoría personalizada para marcas personales y figuras públicas que buscan dominar su nicho digital.",
    tag: "Consultoría",
    image: "https://via.placeholder.com/600x400"
  }
];
---
<section id="proyectos" class="py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">Proyectos que Impulsan el <span class="text-blue-600">Cambio</span></h2>
        <p class="text-lg text-slate-600">Una selección de trabajos donde la estrategia se une con la ejecución impecable.</p>
      </div>
      <a href="#" class="text-blue-600 font-bold flex items-center hover:text-blue-700 transition-colors">
        Ver todos los proyectos
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map(project => (
        <div class="group bg-white rounded-3xl border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
          <div class="aspect-[16/10] bg-slate-100 relative overflow-hidden">
             <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
             <div class="absolute top-4 left-4">
                <span class="bg-white/90 backdrop-blur-sm text-slate-900 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full">{project.tag}</span>
             </div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-slate-900 mb-3">{project.title}</h3>
            <p class="text-slate-600 mb-6">{project.description}</p>
            <a href="#" class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors flex items-center">
              Explorar Caso de Estudio
              <svg class="w-4 h-4 ml-2 opacity-0 group-hover:opacity-100 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
