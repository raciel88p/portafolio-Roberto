---
import { projects } from '../data/projects';

const currentLang = Astro.currentLocale || 'es';
const isEn = currentLang === 'en';

const t = {
  es: {
    title_start: "Proyectos que Impulsan el ",
    title_span: "Cambio",
    description: "Una selección de trabajos donde la estrategia se une con la ejecución impecable.",
    view_all: "Ver todos los proyectos",
    explore: "Explorar Caso",
    visit: "Visitar web"
  },
  en: {
    title_start: "Projects that Drive ",
    title_span: "Change",
    description: "A selection of works where strategy meets flawless execution.",
    view_all: "View all projects",
    explore: "Explore Case Study",
    visit: "Visit website"
  }
}[currentLang as 'es' | 'en'];

// Filter projects by current language
const filteredProjects = projects.filter(p => p.lang === currentLang);
---
<section id="proyectos" class="py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">{t.title_start}<span class="text-blue-600">{t.title_span}</span></h2>
        <p class="text-lg text-slate-600">{t.description}</p>
      </div>
      <a href={isEn ? "/en/proyectos" : "/proyectos"} class="text-blue-600 font-bold flex items-center hover:text-blue-700 transition-colors">
        {t.view_all}
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {filteredProjects.slice(0, 6).map(project => (
        <div class="group bg-white rounded-3xl border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
          <div class="aspect-[16/10] bg-slate-100 relative overflow-hidden">
             <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
             <div class="absolute top-4 left-4">
                <span class="bg-white/90 backdrop-blur-sm text-slate-900 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full">{project.tag}</span>
             </div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-slate-900 mb-3">{project.title}</h3>
            <p class="text-slate-600 mb-6 line-clamp-3">{project.description}</p>
            <div class="flex flex-wrap gap-4">
                <a href={isEn ? `/en/proyectos/${project.slug}` : `/proyectos/${project.slug}`} class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors flex items-center">
                    {t.explore}
                    <svg class="w-4 h-4 ml-2 opacity-0 group-hover:opacity-100 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
                {project.url !== "#" && (
                    <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-slate-400 hover:text-blue-600 transition-colors flex items-center">
                        {t.visit}
                        <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
