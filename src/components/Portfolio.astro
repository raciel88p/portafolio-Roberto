---
const caseStudies = [
  {
    title: "MJ Estética",
    slug: "mj-estetica",
    tag: "AI Growth & SEO Programático",
    problem: "El negocio comenzó con apenas $1.000 en medio de una crisis financiera familiar.",
    solution: "Diseño de la estrategia de negocio, SEO programático con Astro, integración de CRM, automatización del marketing e implementación de agentes de IA.",
    results: ["$75.000 en ingresos durante el primer año.", "Crecimiento del equipo hasta 8 colaboradores.", "Sistema de reservas automatizado 24/7.", "Incremento del 86% en conversiones y ventas."],
    logo: "/logos/mj-estetica.png"
  },
  {
    title: "GolabsTech",
    slug: "golabstech",
    tag: "SEO & GEO",
    problem: "Sin visibilidad internacional ni autoridad de dominio dentro del competitivo mercado de servicios Nearshore e Inteligencia Artificial.",
    solution: "Estrategia global de crecimiento, SEO técnico (hreflang), contenidos dirigidos a ejecutivos C-Level y optimización para motores de búsqueda generativos (GEO).",
    results: ["+253.9% de crecimiento del tráfico orgánico.", "Captación de leads empresariales altamente calificados.", "Recomendado por ChatGPT y Perplexity.", "+139% de nuevos usuarios en seis meses."],
    logo: null
  },
  {
    title: "PadelTennisGuide",
    slug: "padel-tennis-guide",
    tag: "SEO para Directorios",
    problem: "Directorio nuevo con graves problemas de estructura SEO, escaso enlazado interno y baja indexación en WordPress.",
    solution: "Posicionamiento estratégico, desarrollo de un MVP personalizado, arquitectura de información optimizada para buscadores y hoja de ruta para automatización.",
    results: ["Indexación masiva de listados complejos.", "Estructura sólida de enlazado interno.", "Rutas de conversión claras y optimizadas.", "Plan estratégico ejecutado por fases."],
    logo: null
  }
];
---
<section id="proyectos" class="py-24 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div class="max-w-2xl">
        <span class="px-4 py-1.5 text-xs font-bold bg-blue-100 text-blue-700 rounded-full uppercase tracking-wider">Casos de Éxito</span>
        <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-4 mb-6">Resultados Reales, <span class="text-blue-600">No Herramientas</span></h2>
        <p class="text-lg text-slate-600">Los clientes compran resultados. Cada caso de éxito cuenta la historia de una empresa transformada.</p>
      </div>
      <a href="/proyectos" class="text-blue-600 font-bold flex items-center hover:text-blue-700 transition-colors shrink-0">
        Ver todos los casos de estudio
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {caseStudies.map(project => (
        <div class="group bg-slate-50 rounded-3xl border border-slate-100 overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col justify-between h-full p-8">
          <div>
            <div class="flex justify-between items-start mb-6">
              <span class="bg-blue-100 text-blue-800 text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full">{project.tag}</span>
              {project.logo && (
                <img src={project.logo} alt={project.title} class="w-16 h-auto object-contain shrink-0" />
              )}
            </div>

            <h3 class="text-3xl font-extrabold text-slate-900 mb-6">{project.title}</h3>

            <!-- Problem -->
            <div class="mb-6">
              <span class="text-xs font-bold text-red-500 uppercase tracking-wider block mb-1">Problema</span>
              <p class="text-slate-600 text-sm leading-relaxed">{project.problem}</p>
            </div>

            <!-- Solution -->
            <div class="mb-6">
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wider block mb-1">Solución</span>
              <p class="text-slate-700 text-sm leading-relaxed">{project.solution}</p>
            </div>

            <!-- Results -->
            <div class="border-t border-slate-100 pt-6">
              <span class="text-xs font-bold text-green-600 uppercase tracking-wider block mb-3">Resultados</span>
              <ul class="space-y-2">
                {project.results.map(res => (
                  <li class="flex items-start gap-2 text-sm text-slate-800">
                    <span class="text-green-500 font-bold">✔</span>
                    <span>{res}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-8 mt-8 border-t border-slate-100 flex">
            <a href={`/proyectos/${project.slug}`} class="inline-flex items-center text-sm font-bold text-blue-600 hover:text-blue-700 transition-colors">
              Explorar el caso completo
              <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
