---
---
<section id="contacto" class="py-24 bg-blue-600 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Left Column: Direct WhatsApp & Info -->
      <div class="text-white">
        <span class="inline-block py-1.5 px-4 rounded-full bg-white/10 text-white text-xs font-bold uppercase tracking-wider mb-6">
          ¿Listo para despegar?
        </span>
        <h2 class="text-4xl md:text-6xl font-black tracking-tight mb-8 leading-tight">
          Hagamos crecer tu negocio hoy mismo.
        </h2>
        <p class="text-lg text-blue-100 mb-12 max-w-lg leading-relaxed">
          Ya sea que busques automatizar tus flujos con Inteligencia Artificial, optimizar tu estrategia SEO, dominar Google Ads, o desarrollar una plataforma a la medida. Conversemos y definamos tu plan de acción.
        </p>

        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center text-white font-bold text-xl">
              💬
            </div>
            <div>
              <p class="text-xs font-bold text-blue-200 uppercase tracking-wide">WhatsApp Directo</p>
              <p class="text-lg font-bold">Cotáctame via whatsapp: 89871245</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center text-white font-bold text-xl">
              📍
            </div>
            <div>
              <p class="text-xs font-bold text-blue-200 uppercase tracking-wide">Ubicación</p>
              <p class="text-lg font-bold">San José, Costa Rica (Soporte Global)</p>
            </div>
          </div>
        </div>

        <div class="mt-12">
          <a
            href="https://wa.me/50689871245"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center bg-white text-blue-600 font-extrabold px-10 py-5 rounded-2xl hover:bg-slate-900 hover:text-white transition-all shadow-2xl transform hover:-translate-y-1"
          >
            <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.246 2.248 3.484 5.232 3.484 8.412-.003 6.557-5.338 11.892-11.893 11.892-1.997-.001-3.951-.5-5.688-1.448l-6.309 1.656zm6.29-4.143c1.589.943 3.385 1.44 5.215 1.441 5.441 0 9.868-4.427 9.871-9.869 0-2.637-1.03-5.112-2.9-6.981-1.87-1.869-4.346-2.899-6.984-2.9-5.438 0-9.87 4.43-9.873 9.871 0 1.933.565 3.818 1.635 5.465l-1.015 3.703 3.844-1.008zm11.303-4.759c-.31-.154-1.829-.903-2.11-.101-.013-.01.101-.41-.154-.564-.255-.153-.42-.153-.73-.153s-.56.077-.852.385c-.292.308-1.116 1.105-1.116 2.695s1.156 3.13 1.312 3.336c.156.205 2.277 3.475 5.516 4.869.77.332 1.37.53 1.838.678.773.245 1.477.211 2.032.128.618-.093 1.829-.747 2.086-1.47s.256-1.336.179-1.47c-.077-.133-.281-.213-.591-.368z"/></svg>
            Chatear por WhatsApp
          </a>
        </div>
      </div>

      <!-- Right Column: Sleek Lead Capture Form with Honeypot Anti-Spam -->
      <div class="bg-white rounded-[2.5rem] p-8 md:p-12 shadow-2xl border border-blue-500/20 relative">
        <h3 class="text-2xl font-bold text-slate-900 mb-2">Déjame un mensaje</h3>
        <p class="text-sm text-slate-500 mb-8">Te responderé en menos de 24 horas hábiles.</p>

        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
          <!-- Web3Forms Config Key (Optional demo key or standard API target) -->
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />

          <!-- Honeypot Anti-Spam (botcheck field from astro-medical-starter) -->
          <div class="hidden">
            <label class="text-xs text-slate-400">Si eres humano, deja este campo vacío:</label>
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          </div>

          <div>
            <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Nombre Completo</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Ej. Roberto Pérez"
              class="w-full px-5 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-sm"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Correo Electrónico de Negocio</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="Ej. roberto@empresa.com"
              class="w-full px-5 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-sm"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Cuéntame sobre tu proyecto</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Describe brevemente tus objetivos, retos actuales y en qué solución estás interesado..."
              class="w-full px-5 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:bg-white transition-all text-sm resize-none"
            ></textarea>
          </div>

          <div>
            <button
              type="submit"
              class="w-full py-4 px-8 bg-blue-600 text-white font-bold rounded-2xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/20 text-center cursor-pointer"
            >
              Enviar mensaje de contacto
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>

  <!-- Abstract backgrounds -->
  <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-96 h-96 bg-blue-500 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-96 h-96 bg-indigo-700 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
</section>
