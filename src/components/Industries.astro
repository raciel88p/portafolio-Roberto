---
const industriesList = [
  { name: "Healthcare", slug: "salud", icon: "🏥", desc: "Patient acquisition systems and AI agents for medical clinics." },
  { name: "SaaS", slug: "saas", icon: "⚙️", desc: "Product-led SEO and sustainable CAC reduction for software companies." },
  { name: "Cybersecurity", slug: "ciber-seguridad", icon: "🛡️", desc: "B2B authority content and high-value lead gen pipeline for MSSPs." },
  { name: "Real Estate", slug: "real-state", icon: "🏠", desc: "Local SEO, proximity search rankings, and lead capture for agencies." },
  { name: "Technology", slug: "industria-tech", icon: "💻", desc: "Global growth systems, hreflang optimization, and nearshore positioning." },
  { name: "Professional Services", slug: "investigacion-y-desarrollo", icon: "🔬", desc: "Thought leadership, complex data representation, and enterprise trust." },
  { name: "Startups", slug: "startups", icon: "🚀", desc: "Agile validation, search behavior profiling, and rapid traction scaling." },
  { name: "SMBs", slug: "tiendas-electronicas", icon: "🛍️", desc: "Transactional SEO, e-commerce conversion optimization, and automated funnels." }
];
---
<section id="industrias" class="py-24 bg-slate-50 border-t border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-4 py-1.5 text-xs font-bold bg-blue-100 text-blue-700 rounded-full uppercase tracking-wider">Industrias</span>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-4 mb-6">Expertise por Sector</h2>
      <p class="text-lg text-slate-600">Sistemas de crecimiento y optimización personalizados para el modelo de negocio específico de su industria.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {industriesList.map(ind => (
        <a href={`/industrias/${ind.slug}`} class="group bg-white p-8 rounded-3xl border border-slate-100 hover:border-blue-500 hover:shadow-xl transition-all duration-300 flex flex-col justify-between h-full">
          <div>
            <div class="text-4xl mb-6">{ind.icon}</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">{ind.name}</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-6">{ind.desc}</p>
          </div>
          <span class="inline-flex items-center text-xs font-bold text-blue-600 group-hover:text-blue-700">
            Explorar Solución
            <svg class="w-3.5 h-3.5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
