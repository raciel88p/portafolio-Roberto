---
const industriesList = [
  { name: "Salud", slug: "salud", icon: "🏥", desc: "Sistemas de captación de pacientes y agentes de IA para clínicas y centros médicos." },
  { name: "SaaS", slug: "saas", icon: "⚙️", desc: "SEO orientado al producto y reducción sostenible del costo de adquisición de clientes (CAC)." },
  { name: "Ciberseguridad", slug: "ciber-seguridad", icon: "🛡️", desc: "Contenido de autoridad para B2B y sistemas de generación de leads de alto valor para MSSPs." },
  { name: "Bienes Raíces", slug: "real-state", icon: "🏠", desc: "SEO local, posicionamiento por proximidad y sistemas de captación de prospectos para agencias inmobiliarias." },
  { name: "Tecnología", slug: "industria-tech", icon: "💻", desc: "Sistemas globales de crecimiento, optimización hreflang y posicionamiento para empresas Nearshore." },
  { name: "Servicios Profesionales", slug: "investigacion-y-desarrollo", icon: "🔬", desc: "Posicionamiento como líder de opinión, representación de datos complejos y generación de confianza empresarial." },
  { name: "Startups", slug: "startups", icon: "🚀", desc: "Validación ágil de mercado, análisis del comportamiento de búsqueda y aceleración del crecimiento." },
  { name: "eCommerce", slug: "ecommerce", icon: "🛍️", desc: "SEO transaccional, optimización de conversiones para comercio electrónico y embudos automatizados." }
];
---
<section id="industrias" class="py-24 bg-slate-50 border-t border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-4 py-1.5 text-xs font-bold bg-blue-100 text-blue-700 rounded-full uppercase tracking-wider">Industrias</span>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-4 mb-6">Experiencia por Sector</h2>
      <p class="text-lg text-slate-600">Sistemas de crecimiento y optimización adaptados al modelo de negocio de cada industria.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {industriesList.map(ind => (
        <a href={`/industrias/${ind.slug}`} class="group bg-white p-8 rounded-3xl border border-slate-100 hover:border-blue-500 hover:shadow-xl transition-all duration-300 flex flex-col justify-between h-full">
          <div>
            <div class="text-4xl mb-6">{ind.icon}</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">{ind.name}</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-6">{ind.desc}</p>
          </div>
          <span class="inline-flex items-center text-xs font-bold text-blue-600 group-hover:text-blue-700">
            Explorar solución
            <svg class="w-3.5 h-3.5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
