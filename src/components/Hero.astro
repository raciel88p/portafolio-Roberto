---
const stats = [
  { value: "15+", label: "Años de experiencia" },
  { value: "$200K+", label: "Negocios escalados" },
  { value: "6800%", label: "Crecimiento orgánico" },
  { value: "2100+", label: "Leads calificados" },
  { value: "25+", label: "Industrias" },
  { value: "50+", label: "Proyectos completados" }
];
---
<section id="inicio" class="relative pt-32 pb-24 lg:pt-48 lg:pb-36 overflow-hidden bg-slate-900 text-white">
  <!-- Background video from astro-medical-starter styling -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <video
      autoplay
      loop
      muted
      playsinline
      class="absolute inset-0 w-full h-full object-cover opacity-15 mix-blend-screen"
      src="https://assets.mixkit.co/videos/preview/mixkit-futuristic-technology-digital-grid-background-48197-large.mp4"
    >
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-slate-900/50"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-4xl mx-auto mb-20">
      <span class="inline-block py-1.5 px-4 rounded-full bg-blue-500/10 text-blue-400 text-sm font-bold tracking-wide uppercase mb-6">
        Consultor de Crecimiento Empresarial con IA
      </span>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight mb-8 leading-none">
        Escala tus ingresos.<br/>
        Reduce costos.<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-blue-500 to-indigo-400">Construye negocios impulsados por Inteligencia Artificial.</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-300 max-w-3xl mx-auto mb-12 leading-relaxed">
        Ayudo a startups y pequeñas y medianas empresas (PYMES) a acelerar su crecimiento mediante inteligencia artificial, automatización, transformación digital y sistemas de adquisición de clientes.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="https://wa.me/50689871245" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-blue-600 text-white text-lg font-bold rounded-xl hover:bg-blue-700 transition-all shadow-xl shadow-blue-500/20 flex items-center justify-center">
          Agendar una llamada estratégica
        </a>
        <a href="#proyectos" class="px-8 py-4 bg-white/10 text-white hover:bg-white/20 text-lg font-bold rounded-xl border border-white/10 hover:border-white/20 transition-all flex items-center justify-center">
          Ver casos de éxito
        </a>
      </div>
    </div>

    <!-- Impact in Business stats grid -->
    <div class="border-t border-white/5 pt-16">
      <div class="text-center mb-10">
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-500">Impacto en los Negocios</h3>
        <p class="text-sm text-slate-400 mt-2">No se trata de herramientas. Se trata de resultados.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
        {stats.map(stat => (
          <div class="text-center p-6 bg-white/5 border border-white/5 rounded-2xl hover:border-blue-500/30 transition-all">
            <p class="text-3xl md:text-4xl font-extrabold text-blue-400 mb-2">{stat.value}</p>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Decorative background elements -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-0 opacity-30 pointer-events-none">
    <div class="absolute top-[-10%] left-[-15%] w-[50%] h-[50%] rounded-full bg-blue-500/20 blur-[130px]"></div>
    <div class="absolute bottom-[-10%] right-[-15%] w-[50%] h-[50%] rounded-full bg-indigo-500/20 blur-[130px]"></div>
  </div>
</section>
