---
const industries = [
  "Industria Tech", "Real State", "Salud", "Startups", "Betting",
  "Poker Online", "Espiritual", "Tiendas Electrónicas", "Saas",
  "Ciber Seguridad", "Investigación y desarrollo", "Seguros", "Turismo"
];

const services = [
  { title: "LLMs Optimization", slug: "llm-optimization" },
  { title: "Local SEO", slug: "local-seo" },
  { title: "Youtube SEO", slug: "youtube-seo" },
  { title: "Wordpress SEO", slug: "wordpress-seo" },
  { title: "Headless CMS SEO", slug: "headless-cms-seo" },
  { title: "Ai Growth Engineer", slug: "ai-growth-engineer" },
  { title: "Consultoría SEO", slug: "consultor-seo" },
  { title: "Desarrollo Web & Apps", slug: "desarrollo-web-apps" },
  { title: "Programmatic SEO", slug: "programmatic-seo" }
];
---
<nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20 items-center">
      <div class="flex-shrink-0">
        <a href="/" class="text-2xl font-bold tracking-tighter text-slate-900">ROBERTO<span class="text-blue-600">PÉREZ</span></a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button type="button" id="mobile-menu-button" class="inline-flex items-center justify-center p-2 rounded-md text-slate-600 hover:text-blue-600 hover:bg-slate-100 focus:outline-none transition-colors" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Abrir menú principal</span>
          <svg id="hamburger-icon" class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="hidden md:block">
        <div class="ml-10 flex items-center space-x-8">
          <div class="relative group">
            <button class="flex items-center text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors cursor-pointer">
              Industrias
              <svg class="ml-1 w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="absolute left-0 mt-0 w-64 bg-white border border-slate-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-left -translate-y-2 group-hover:translate-y-0 z-50 py-2">
              <div class="grid grid-cols-1 gap-1 px-2">
                {industries.map(industry => (
                  <a href={`/industrias/${industry.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-')}`} class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 rounded-lg transition-colors">
                    {industry}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <div class="relative group">
            <button class="flex items-center text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors cursor-pointer">
              Servicios
              <svg class="ml-1 w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="absolute left-0 mt-0 w-64 bg-white border border-slate-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-left -translate-y-2 group-hover:translate-y-0 z-50 py-2">
              <div class="grid grid-cols-1 gap-1 px-2">
                {services.map(service => (
                  <a href={`/servicios/${service.slug}`} class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 rounded-lg transition-colors">
                    {service.title}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a href="/nearshore" class="text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors">Nearshore</a>
          <a href="/#sobre-mi" class="text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors">Sobre Mí</a>
          <a href="/#proyectos" class="text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors">Proyectos</a>
          <a href="/#contacto" class="bg-blue-600 text-white px-6 py-3 rounded-full text-sm font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-200 ml-4">Trabajemos Juntos</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile menu, show/hide based on menu state. -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-100 overflow-y-auto max-h-[calc(100vh-5rem)] transition-all duration-300 ease-in-out">
    <div class="px-4 pt-2 pb-6 space-y-1">
      <!-- Industries Dropdown -->
      <div class="space-y-1">
        <button id="mobile-industries-button" class="w-full flex items-center justify-between text-slate-600 hover:text-blue-600 px-3 py-2 text-base font-medium transition-colors">
          Industrias
          <svg id="mobile-industries-arrow" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="mobile-industries-menu" class="hidden pl-4 grid grid-cols-1 gap-1">
          {industries.map(industry => (
            <a href={`/industrias/${industry.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-')}`} class="block px-3 py-2 text-sm text-slate-600 hover:text-blue-600 transition-colors">
              {industry}
            </a>
          ))}
        </div>
      </div>

      <!-- Services Dropdown -->
      <div class="space-y-1">
        <button id="mobile-services-button" class="w-full flex items-center justify-between text-slate-600 hover:text-blue-600 px-3 py-2 text-base font-medium transition-colors">
          Servicios
          <svg id="mobile-services-arrow" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="mobile-services-menu" class="hidden pl-4 grid grid-cols-1 gap-1">
          {services.map(service => (
            <a href={`/servicios/${service.slug}`} class="block px-3 py-2 text-sm text-slate-600 hover:text-blue-600 transition-colors">
              {service.title}
            </a>
          ))}
        </div>
      </div>

      <a href="/nearshore" class="block text-slate-600 hover:text-blue-600 px-3 py-2 text-base font-medium transition-colors">Nearshore</a>
      <a href="/#sobre-mi" class="block text-slate-600 hover:text-blue-600 px-3 py-2 text-base font-medium transition-colors">Sobre Mí</a>
      <a href="/#proyectos" class="block text-slate-600 hover:text-blue-600 px-3 py-2 text-base font-medium transition-colors">Proyectos</a>
      <div class="pt-4">
        <a href="/#contacto" class="block text-center bg-blue-600 text-white px-6 py-3 rounded-full text-base font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-200">Trabajemos Juntos</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  const industriesButton = document.getElementById('mobile-industries-button');
  const industriesMenu = document.getElementById('mobile-industries-menu');
  const industriesArrow = document.getElementById('mobile-industries-arrow');

  const servicesButton = document.getElementById('mobile-services-button');
  const servicesMenu = document.getElementById('mobile-services-menu');
  const servicesArrow = document.getElementById('mobile-services-arrow');

  function toggleMenu() {
    const isExpanded = mobileMenuButton?.getAttribute('aria-expanded') === 'true';
    mobileMenuButton?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);

  industriesButton?.addEventListener('click', () => {
    industriesMenu?.classList.toggle('hidden');
    industriesArrow?.classList.toggle('rotate-180');
  });

  servicesButton?.addEventListener('click', () => {
    servicesMenu?.classList.toggle('hidden');
    servicesArrow?.classList.toggle('rotate-180');
  });

  // Close mobile menu when clicking on a link
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
