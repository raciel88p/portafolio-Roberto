---
const industries = [
  "Industria Tech", "Real State", "Salud", "Startups", "Betting",
  "Poker Online", "Espiritual", "Tiendas Electrónicas", "Saas",
  "Ciber Seguridad", "Investigación y desarrollo", "Seguros", "Turismo"
];

const services = [
  { title: "Ai Growth Strategy", slug: "ai-growth-strategy" },
  { title: "GEO Optimization", slug: "geo-optimization" },
  { title: "Local SEO", slug: "local-seo" },
  { title: "Youtube SEO", slug: "youtube-seo" },
  { title: "Wordpress SEO", slug: "wordpress-seo" },
  { title: "Headless CMS SEO", slug: "headless-cms-seo" },
  { title: "Ai Growth Engineer", slug: "ai-growth-engineer" },
  { title: "Consultoría SEO", slug: "consultor-seo" },
  { title: "Desarrollo Web & Apps", slug: "desarrollo-web-apps" },
  { title: "Programmatic SEO", slug: "programmatic-seo" },
  { title: "SEO para Directorios", slug: "seo-directorios" },
  { title: "Servicio de SEM", slug: "servicio-sem" }
];

const technologies = [
  "WordPress", "PHP", "Node js", "Python", "Webflow",
  "Automatizaciones agenticas", "Asistentes agenticos", "N8n", "Looker", "Google Tag Manager", "Google Analytics 4"
];
---
<nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20 items-center">
      <div class="flex-shrink-0">
        <a href="/" class="text-2xl font-bold tracking-tighter text-slate-900">ROBERTO<span class="text-blue-600">PÉREZ</span></a>
      </div>
      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button id="mobile-menu-button" type="button" class="text-slate-600 hover:text-blue-600 p-2 focus:outline-none" aria-label="Abrir menú">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon-open" class="block" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="hidden md:block">
        <div class="ml-10 flex items-center space-x-8">
          <a href="/nearshore" class="text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors">Nearshore</a>
          <div class="relative group">
            <button class="flex items-center text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors cursor-pointer">
              Industrias
              <svg class="ml-1 w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="absolute left-0 mt-0 w-64 bg-white border border-slate-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-left -translate-y-2 group-hover:translate-y-0 z-50 py-2">
              <div class="grid grid-cols-1 gap-1 px-2">
                {industries.map(industry => (
                  <a href={`/industrias/${industry.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-')}`} class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 rounded-lg transition-colors">
                    {industry}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <div class="relative group">
            <button class="flex items-center text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors cursor-pointer">
              Soluciones de Negocio
              <svg class="ml-1 w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="absolute left-0 mt-0 w-64 bg-white border border-slate-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-left -translate-y-2 group-hover:translate-y-0 z-50 py-2">
              <div class="grid grid-cols-1 gap-1 px-2">
                {services.map(service => (
                  <a href={`/servicios/${service.slug}`} class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 rounded-lg transition-colors">
                    {service.title}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <div class="relative group">
            <button class="flex items-center text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors cursor-pointer">
              Tecnología
              <svg class="ml-1 w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="absolute left-0 mt-0 w-64 bg-white border border-slate-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-left -translate-y-2 group-hover:translate-y-0 z-50 py-2">
              <div class="grid grid-cols-1 gap-1 px-2">
                {technologies.map(tech => (
                  <a href={`/tecnologias/${tech.toLowerCase().replace(/\s+/g, '-')}`} class="block px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 rounded-lg transition-colors">
                    {tech}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a href="/sobre-mi" class="text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors">Sobre Mí</a>
          <a href="/proyectos" class="text-slate-600 hover:text-blue-600 px-3 py-2 text-sm font-medium transition-colors">Proyectos</a>
          <a href="/#contacto" class="bg-blue-600 text-white px-6 py-3 rounded-full text-sm font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-200 ml-4">Trabajemos Juntos</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-100 h-screen overflow-y-auto pb-20">
    <div class="px-4 pt-4 pb-6 space-y-2">
      <a href="/nearshore" class="block text-slate-900 font-bold text-lg py-4 border-b border-slate-50">Nearshore</a>
      <!-- Industries Mobile -->
      <div class="py-2">
        <button id="mobile-industries-toggle" class="flex items-center justify-between w-full text-slate-900 font-bold text-lg py-2">
          Industrias
          <svg class="ml-1 w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="mobile-industries-list" class="hidden pl-4 mt-2 grid grid-cols-1 gap-2">
          {industries.map(industry => (
            <a href={`/industrias/${industry.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-')}`} class="block py-2 text-slate-600 text-sm">
              {industry}
            </a>
          ))}
        </div>
      </div>

      <!-- Services Mobile -->
      <div class="py-2">
        <button id="mobile-services-toggle" class="flex items-center justify-between w-full text-slate-900 font-bold text-lg py-2">
          Soluciones de Negocio
          <svg class="ml-1 w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="mobile-services-list" class="hidden pl-4 mt-2 grid grid-cols-1 gap-2">
          {services.map(service => (
            <a href={`/servicios/${service.slug}`} class="block py-2 text-slate-600 text-sm">
              {service.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Tech Mobile -->
      <div class="py-2">
        <button id="mobile-tech-toggle" class="flex items-center justify-between w-full text-slate-900 font-bold text-lg py-2">
          Tecnología
          <svg class="ml-1 w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="mobile-tech-list" class="hidden pl-4 mt-2 grid grid-cols-1 gap-2">
          {technologies.map(tech => (
            <a href={`/tecnologias/${tech.toLowerCase().replace(/\s+/g, '-')}`} class="block py-2 text-slate-600 text-sm">
              {tech}
            </a>
          ))}
        </div>
      </div>

      <a href="/sobre-mi" class="block text-slate-900 font-bold text-lg py-4 border-b border-slate-50">Sobre Mí</a>
      <a href="/proyectos" class="block text-slate-900 font-bold text-lg py-4 border-b border-slate-50">Proyectos</a>

      <div class="pt-10">
        <a href="/#contacto" class="block w-full bg-blue-600 text-white text-center px-6 py-4 rounded-2xl font-bold shadow-lg">
          Trabajemos Juntos
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const industriesToggle = document.getElementById('mobile-industries-toggle');
  const industriesList = document.getElementById('mobile-industries-list');

  const servicesToggle = document.getElementById('mobile-services-toggle');
  const servicesList = document.getElementById('mobile-services-list');

  const techToggle = document.getElementById('mobile-tech-toggle');
  const techList = document.getElementById('mobile-tech-list');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    // Prevent scrolling when menu is open
    document.body.classList.toggle('overflow-hidden');
  });

  industriesToggle?.addEventListener('click', () => {
    industriesList?.classList.toggle('hidden');
    industriesToggle.querySelector('svg')?.classList.toggle('rotate-180');
  });

  servicesToggle?.addEventListener('click', () => {
    servicesList?.classList.toggle('hidden');
    servicesToggle.querySelector('svg')?.classList.toggle('rotate-180');
  });

  techToggle?.addEventListener('click', () => {
    techList?.classList.toggle('hidden');
    techToggle.querySelector('svg')?.classList.toggle('rotate-180');
  });

  // Close menu on link clicks
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    });
  });
</script>
