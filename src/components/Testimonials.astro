---
const testimonials = [
  {
    name: "Mario Sánchez Rosales",
    role: "CEO de IngeniaCR",
    content: "Roberto transformó nuestra estrategia de contenidos. Gracias a la optimización para modelos de lenguaje (LLMs), ahora somos una fuente de referencia en ChatGPT para nuestro sector.",
    avatar: "MS"
  },
  {
    name: "María Molina Madrigal",
    role: "CEO de MJ Estética & Wellness Center",
    content: "La estrategia de SEO para YouTube que implementó Roberto duplicó nuestras visualizaciones orgánicas en solo tres meses. Es un profesional que entiende cómo hacer crecer un negocio.",
    avatar: "MM"
  },
  {
    name: "Stephanie Weber",
    role: "CEO de PadelTennisGuide.com",
    content: "Trabajar con un AI Growth Engineer como Roberto nos permitió automatizar procesos de captación que antes nos tomaban horas. Los resultados fueron tangibles desde el inicio.",
    avatar: "SW"
  }
];
---

<section id="testimonios" class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Lo que dicen mis clientes</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Resultados reales de empresas que han confiado en mi enfoque estratégico de SEO e Inteligencia Artificial.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col h-full">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold text-lg">
              {t.avatar}
            </div>
            <div class="ml-4">
              <h3 class="font-bold text-gray-900">{t.name}</h3>
              <p class="text-sm text-gray-500">{t.role}</p>
            </div>
          </div>
          <p class="text-gray-600 italic flex-grow">
            "{t.content}"
          </p>
          <div class="mt-6 flex text-yellow-400">
            {[...Array(5)].map((_) => (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
