---
<footer class="bg-slate-900 text-white py-20 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 border-b border-slate-800 pb-16 mb-12">

      <!-- Column 1: Brand Info -->
      <div class="lg:col-span-2 space-y-6">
        <a href="/" class="text-2xl font-bold tracking-tighter text-white inline-block">
          ROBERTO<span class="text-blue-500">PÉREZ</span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          Consultor SEO y de Marketing Digital. Ayudando a emprendedores, firmas profesionales y empresas a escalar su presencia digital mediante sistemas integrados de crecimiento orgánico e Inteligencia Artificial.
        </p>
        <div class="space-y-2 text-sm text-slate-300">
          <p><span class="text-blue-400 font-bold">💬 WhatsApp:</span> +506 8987-1245</p>
          <p><span class="text-blue-400 font-bold">📍 Ubicación:</span> San José, Costa Rica (Soporte Global)</p>
        </div>
        <div class="flex space-x-4 pt-2">
          <a href="https://www.linkedin.com/in/roberto88/" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-slate-800 rounded-lg text-xs font-bold text-slate-300 hover:bg-blue-600 hover:text-white transition-all border border-slate-700">
            LinkedIn
          </a>
          <a href="https://www.youtube.com/@recursosparaemprendedores88" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-slate-800 rounded-lg text-xs font-bold text-slate-300 hover:bg-red-600 hover:text-white transition-all border border-slate-700">
            YouTube
          </a>
        </div>
      </div>

      <!-- Column 2: Menú Principal & Navegación -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-6">Navegación Principal</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/" class="text-slate-300 hover:text-white transition-colors">Inicio</a></li>
          <li><a href="/nearshore" class="text-slate-300 hover:text-white transition-colors">Nearshore</a></li>
          <li><a href="/sobre-mi" class="text-slate-300 hover:text-white transition-colors">Sobre Mí</a></li>
          <li><a href="/proyectos" class="text-slate-300 hover:text-white transition-colors">Casos de Éxito / Proyectos</a></li>
          <li><a href="/blog" class="text-slate-300 hover:text-white transition-colors">Blog</a></li>
          <li><a href="/#contacto" class="text-slate-300 hover:text-white transition-colors font-bold text-blue-400">Trabajemos Juntos</a></li>
        </ul>
      </div>

      <!-- Column 3: Soluciones de Negocio -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-6">Soluciones de Negocio</h3>
        <ul class="space-y-2.5 text-xs">
          {services.map((s) => (
            <li>
              <a href={`/servicios/${s.slug}`} class="text-slate-300 hover:text-white transition-colors">
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Industrias & Tecnología -->
      <div class="space-y-8">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-4">Industrias</h3>
          <div class="flex flex-wrap gap-1.5">
            {industries.map((i) => (
              <a href={`/industrias/${i.slug}`} class="px-2 py-1 bg-slate-800/80 rounded text-[11px] text-slate-300 hover:bg-blue-600 hover:text-white transition-colors border border-slate-700/50">
                {i.title}
              </a>
            ))}
          </div>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-4">Tecnologías</h3>
          <div class="flex flex-wrap gap-1.5">
            {technologies.map((t) => (
              <a href={`/tecnologias/${t.slug}`} class="px-2 py-1 bg-slate-800/80 rounded text-[11px] text-slate-300 hover:bg-blue-600 hover:text-white transition-colors border border-slate-700/50">
                {t.title}
              </a>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row justify-between items-center text-slate-500 text-xs">
      <p>© {new Date().getFullYear()} Roberto Pérez Salazar. Todos los derechos reservados.</p>
      <div class="mt-4 md:mt-0 flex space-x-6">
        <a href="/" class="hover:text-slate-300 transition-colors">Inicio</a>
        <a href="/sobre-mi" class="hover:text-slate-300 transition-colors">Contacto</a>
      </div>
    </div>
  </div>
</footer>
