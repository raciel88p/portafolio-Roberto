---
const currentLang = Astro.currentLocale || 'es';
const isEn = currentLang === 'en';

const t = {
  es: {
    description: "Ayudando a emprendedores y empresas a escalar su presencia digital mediante estrategias de alto impacto.",
    quick_links: "Enlaces Rápidos",
    home: "Inicio",
    about: "Sobre Mí",
    projects: "Proyectos",
    contact: "Contacto",
    rights: "Todos los derechos reservados.",
    privacy: "Política de Privacidad",
    terms: "Términos de Servicio"
  },
  en: {
    description: "Helping entrepreneurs and companies scale their digital presence through high-impact strategies.",
    quick_links: "Quick Links",
    home: "Home",
    about: "About Me",
    projects: "Projects",
    contact: "Contact",
    rights: "All rights reserved.",
    privacy: "Privacy Policy",
    terms: "Terms of Service"
  }
}[currentLang as 'es' | 'en'];
---
<footer class="bg-slate-900 text-white py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 border-b border-slate-800 pb-12 mb-12">
      <div>
        <h2 class="text-2xl font-bold mb-6">Roberto Pérez Salazar</h2>
        <p class="text-slate-400 max-w-xs">
          {t.description}
        </p>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-slate-500 mb-6">{t.quick_links}</h3>
        <ul class="space-y-4">
          <li><a href={isEn ? "/en" : "/"} class="text-slate-300 hover:text-white transition-colors">{t.home}</a></li>
          <li><a href={isEn ? "/en/sobre-mi" : "/sobre-mi"} class="text-slate-300 hover:text-white transition-colors">{t.about}</a></li>
          <li><a href="/proyectos" class="text-slate-300 hover:text-white transition-colors">{t.projects}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-slate-500 mb-6">{t.contact}</h3>
        <p class="text-slate-300 mb-4">contacto@robertoperez.com</p>
        <div class="flex space-x-6">
          <a href="https://www.linkedin.com/in/roberto88/" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">LinkedIn</a>
          <a href="https://www.youtube.com/@recursosparaemprendedores88" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors">YouTube</a>
        </div>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-between items-center text-slate-500 text-sm">
      <p>© {new Date().getFullYear()} Roberto Pérez Salazar. {t.rights}</p>
      <div class="mt-4 md:mt-0 flex space-x-8">
        <a href="#" class="hover:text-white transition-colors">{t.privacy}</a>
        <a href="#" class="hover:text-white transition-colors">{t.terms}</a>
      </div>
    </div>
  </div>
</footer>
