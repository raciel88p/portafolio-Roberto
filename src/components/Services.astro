---
const problems = [
  {
    title: "Tus ingresos no están creciendo",
    text: "Identifico oportunidades de crecimiento y construyo sistemas que generan una adquisición de clientes predecible.",
    icon: "📈"
  },
  {
    title: "Tu equipo pierde tiempo en tareas repetitivas",
    text: "Automatizo procesos utilizando inteligencia artificial y flujos de trabajo para maximizar la eficiencia.",
    icon: "⏱️"
  },
  {
    title: "Tu marketing no está generando retorno de inversión",
    text: "Diseño sistemas de adquisición basados en datos y no en suposiciones para garantizar la rentabilidad.",
    icon: "🎯"
  },
  {
    title: "Tu operación no escala",
    text: "Optimizo procesos para que tu empresa pueda crecer sin aumentar la complejidad operativa.",
    icon: "⚙️"
  }
];

const frameworkPhases = [
  { phase: "Fase 1", title: "Auditoría del Negocio", desc: "Análisis profundo de las métricas actuales, canales de adquisición y cuellos de botella operativos." },
  { phase: "Fase 2", title: "Validación de Mercado", desc: "Análisis de la intención de búsqueda, brechas frente a la competencia y oportunidades de audiencias con alta conversión." },
  { phase: "Fase 3", title: "Estrategia de Crecimiento", desc: "Diseño de un plan integral para la adquisición de clientes y generación de ingresos." },
  { phase: "Fase 4", title: "Automatización con IA", desc: "Implementación de n8n, Claude, OpenAI y agentes de CRM para eliminar tareas repetitivas del equipo." },
  { phase: "Fase 5", title: "Adquisición de Clientes", desc: "Ejecución de estrategias de SEO, GEO, YouTube y publicidad pagada para captar tráfico con alta intención de compra." },
  { phase: "Fase 6", title: "Optimización Continua", desc: "Implementación de CRO, embudos de conversión, dashboards y mejoras continuas basadas en analítica." }
];

const reorganizedServices = [
  {
    title: "Estrategia de Crecimiento Empresarial con IA",
    icon: "🧠",
    description: "Evaluación integral del negocio, diseño del roadmap estratégico, definición de KPIs y priorización de iniciativas.",
    tags: ["Evaluación", "Roadmap", "KPIs", "Prioridades"]
  },
  {
    title: "Automatización con IA",
    icon: "🤖",
    description: "Implementación de automatizaciones avanzadas y agentes inteligentes para optimizar procesos repetitivos.",
    tags: ["n8n", "Claude", "OpenAI", "Agentes IA", "CRM", "Automatización"]
  },
  {
    title: "Adquisición de Clientes",
    icon: "🎯",
    description: "Sistemas para captar tráfico con alta intención de compra mediante canales orgánicos e impulsados por IA.",
    tags: ["SEO", "GEO", "Google", "YouTube", "Publicidad Pagada"]
  },
  {
    title: "Optimización de Ingresos",
    icon: "📊",
    description: "Optimización de la tasa de conversión, embudos de ventas, analítica web avanzada y paneles interactivos.",
    tags: ["CRO", "Embudos", "Analítica", "Dashboards"]
  },
  {
    title: "Transformación Digital",
    icon: "⚡",
    description: "Modernización de la infraestructura tecnológica mediante IA, CMS desacoplados (Headless CMS), CRM e integración de procesos.",
    tags: ["IA", "CMS", "CRM", "Optimización de procesos"]
  }
];
---

<!-- Problems I Solve Section -->
<section id="problemas" class="py-24 bg-slate-50 border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-4 py-1.5 text-xs font-bold bg-red-100 text-red-700 rounded-full uppercase tracking-wider">Enfoque en Soluciones</span>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-4 mb-6">Problemas que Resuelvo</h2>
      <p class="text-lg text-slate-600">No vendo SEO como un fin. Resuelvo los problemas que limitan el crecimiento de tu empresa.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {problems.map(prob => (
        <div class="p-8 bg-white rounded-3xl border border-slate-100 shadow-sm flex items-start gap-6 hover:shadow-md transition-all">
          <div class="text-4xl bg-red-50 p-4 rounded-2xl text-red-600">{prob.icon}</div>
          <div>
            <h3 class="text-2xl font-bold text-slate-900 mb-2">{prob.title}</h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">{prob.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Business Growth Framework Section -->
<section id="metodologia" class="py-24 bg-slate-900 text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="px-4 py-1.5 text-xs font-bold bg-blue-500/10 text-blue-400 rounded-full uppercase tracking-wider">Metodología Comprobada</span>
      <h2 class="text-4xl md:text-5xl font-black mt-4 mb-6">Business Growth Framework</h2>
      <p class="text-lg text-slate-300"><span class="font-bold">AI Growth Operating System™</span>: una metodología estratégica para escalar la adquisición de clientes y optimizar la rentabilidad.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {frameworkPhases.map((phase) => (
        <div class="p-8 bg-white/5 border border-white/5 rounded-3xl hover:border-blue-500/30 transition-all flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-blue-400 uppercase tracking-widest block mb-4">{phase.phase}</span>
            <h3 class="text-2xl font-bold mb-4">{phase.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{phase.desc}</p>
          </div>
          <div class="w-full h-1 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full mt-8 opacity-40"></div>
        </div>
      ))}
    </div>
  </div>
  <!-- Blur backgrounds -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-blue-500/10 rounded-full blur-[100px] -z-0"></div>
</section>

<!-- Reorganized Services Section -->
<section id="servicios" class="py-24 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-4 py-1.5 text-xs font-bold bg-blue-100 text-blue-700 rounded-full uppercase tracking-wider">Servicios Especializados</span>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 mt-4 mb-6">Sistemas de Adquisición y Crecimiento</h2>
      <p class="text-lg text-slate-600">Soluciones de crecimiento empresarial que combinan tecnología, analítica y optimización avanzada.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {reorganizedServices.map(service => (
        <div class="p-8 rounded-3xl border border-slate-100 hover:border-blue-100 hover:bg-blue-50/20 transition-all flex flex-col justify-between h-full group">
          <div>
            <div class="text-4xl mb-6">{service.icon}</div>
            <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-blue-600 transition-colors">{service.title}</h3>
            <p class="text-slate-600 leading-relaxed text-sm mb-6">{service.description}</p>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-slate-50">
            {service.tags.map(tag => (
              <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
