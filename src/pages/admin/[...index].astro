<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Sanity Studio | Admin</title>
    <style is:global>
        html, body {
            margin: 0;
            padding: 0;
            height: 100dvh;
            width: 100vw;
            overflow: hidden;
            background-color: #f1f2f3;
        }
        #sanity-studio-root {
            height: 100dvh;
            width: 100vw;
        }
        /* Fix Sanity Studio action bar on mobile */
        [data-testid="document-panel-footer"] {
            position: fixed !important;
            bottom: 0 !important;
            left: 0 !important;
            right: 0 !important;
            z-index: 9999 !important;
            background: white !important;
            border-top: 1px solid #ddd !important;
            display: flex !important;
            padding: 10px !important;
            padding-bottom: calc(10px + env(safe-area-inset-bottom)) !important;
        }
        /* Ensure the main pane doesn't get hidden under the fixed footer */
        [data-testid="document-panel"] > div:first-child {
            padding-bottom: 80px !important;
        }
    </style>
</head>
<body>
    <div id="sanity-studio-root"></div>
    <script>
        import { renderStudio } from 'sanity'
        import config from '../../../sanity.config'
        const target = document.getElementById('sanity-studio-root')
        if (target) {
            renderStudio(target, config)
        }
    </script>
</body>
</html>
