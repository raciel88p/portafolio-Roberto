---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const featuredCourse = {
  title: "Curso Avanzado: Sistemas de Crecimiento con Inteligencia Artificial & SEO",
  tag: "Curso Más Vendido",
  description: "Aprende paso a paso a diseñar e implementar sistemas de adquisición de clientes automatizados, arquitecturas SEO programáticas y flujos de IA con n8n, Claude y OpenAI.",
  modules: [
    "Fundamentos de AI Growth Operating System™",
    "Automatización de workflows con n8n y Python",
    "SEO Programático y Optimización GEO/AEO",
    "Modelos de atribución y analítica ejecutiva en Looker Studio"
  ],
  link: "https://wa.me/50689871245?text=Hola%20Roberto,%20quiero%20informaci%C3%B3n%20sobre%20el%20curso%20m%C3%A1s%20vendido%20de%20IA%20y%20Growth"
};
---

<Layout
  title="Página No Encontrada (404) | Roberto Pérez Salazar"
  description="La página que buscas no existe o ha sido movida. Explora nuestras soluciones de crecimiento o nuestro curso más vendido sobre Inteligencia Artificial y SEO."
>
  <Navbar />

  <main class="pt-32 pb-24 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <!-- 404 Hero -->
      <div class="mb-16">
        <span class="px-4 py-1.5 text-xs font-bold bg-red-100 text-red-700 rounded-full uppercase tracking-wider">
          Error 404
        </span>
        <h1 class="text-6xl md:text-8xl font-black text-slate-900 mt-4 mb-6">
          404
        </h1>
        <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-4">
          Parece que la página que buscas no existe
        </h2>
        <p class="text-slate-600 max-w-lg mx-auto mb-8 text-base">
          Es posible que la dirección haya cambiado o que el contenido haya sido movido a una nueva sección.
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <a href="/" class="px-6 py-3 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700 transition-all shadow-md">
            Volver al Inicio
          </a>
          <a href="/proyectos" class="px-6 py-3 bg-slate-100 text-slate-800 rounded-xl font-bold hover:bg-slate-200 transition-all border border-slate-200">
            Ver Casos de Éxito
          </a>
        </div>
      </div>

      <!-- Featured Course Section ("Curso Más Vendido") -->
      <div class="bg-slate-900 text-white p-8 md:p-12 rounded-3xl text-left border border-slate-800 shadow-2xl relative overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <span class="px-3 py-1 text-xs font-black bg-amber-400 text-amber-950 uppercase tracking-wider rounded-full">
            🔥 {featuredCourse.tag}
          </span>
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Programa Destacado</span>
        </div>

        <h3 class="text-2xl md:text-3xl font-black text-white mb-4">
          {featuredCourse.title}
        </h3>

        <p class="text-slate-300 text-sm leading-relaxed mb-6">
          {featuredCourse.description}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8 text-xs font-bold text-slate-200">
          {featuredCourse.modules.map((m) => (
            <div class="p-3 bg-slate-800/80 border border-slate-700/60 rounded-xl flex items-center gap-2">
              <span class="text-amber-400 font-black">✓</span>
              <span>{m}</span>
            </div>
          ))}
        </div>

        <div class="pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
          <span class="text-xs text-slate-400 font-semibold">Acceso inmediato con acompañamiento directo</span>
          <a
            href={featuredCourse.link}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-3.5 bg-amber-400 text-amber-950 font-extrabold rounded-xl hover:bg-amber-300 transition-all text-center shadow-lg"
          >
            Solicitar Información del Curso
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
