                </div>
                <div class="p-3 bg-slate-800 rounded-xl border border-slate-700">
                  <strong class="text-blue-400 block mb-1 uppercase tracking-wider text-[10px]">Estrategia</strong>
                  <span>{ind.caseStudy.strategy}</span>
                </div>
                <div class="p-3 bg-slate-800 rounded-xl border border-slate-700">
                  <strong class="text-emerald-400 block mb-1 uppercase tracking-wider text-[10px]">Resultado</strong>
                  <span class="font-bold text-white">{ind.caseStudy.result}</span>
                </div>
              </div>
            </div>

            <!-- Block 7 & 8: Related Services & Related Tech -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-200 text-xs md:text-sm">
