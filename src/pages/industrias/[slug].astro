---
import IndustryLayout from '../../layouts/IndustryLayout.astro';

export async function getStaticPaths() {
  const industries = [
    {
      slug: "investigacion-y-desarrollo",
      name: "Investigación y desarrollo",
      icon: "🔬",
      description: "Visibilidad para la innovación científica. Conectamos laboratorios y proyectos de I+D con socios, inversores y talento especializado.",
      details: [
        { title: "Divulgación Estratégica", text: "Optimizamos el alcance de tus hallazgos para atraer colaboraciones de alto impacto." },
        { title: "Ecosistema de Innovación", text: "Posicionamos tu centro como referente en el avance tecnológico y científico." }
      ]
    },
    {
      slug: "seguros",
      name: "Seguros",
      icon: "📜",
      description: "Protección a un clic de distancia. Estrategias de visibilidad para aseguradoras y corredurías en un mercado basado en la solvencia y la cercanía.",
      details: [
        { title: "Búsquedas de Decisión", text: "Comparativas y contenido informativo que guía al usuario hacia la póliza adecuada." },
        { title: "Captación Local", text: "Aseguramos que tu agencia sea la referencia para quienes buscan protección en su ciudad." }
      ]
    }
  ];

  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
---

<IndustryLayout
  industry={industry.name}
  description={industry.description}
  icon={industry.icon}
  details={industry.details}
/>
