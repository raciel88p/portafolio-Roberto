---
import IndustryLayout from '../../layouts/IndustryLayout.astro';

export async function getStaticPaths() {
  const industries = [
    {
      slug: "betting",
      name: "Betting",
      icon: "🎲",
      description: "Navegamos la complejidad con precisión técnica. Posicionamos plataformas de apuestas en mercados altamente competitivos y regulados.",
      details: [
        { title: "SEO de Alta Competición", text: "Estrategias agresivas de autoridad para destacar en nichos donde cada clic es crítico." },
        { title: "Gestión de Compliance", text: "Contenido y estructuras técnicas que cumplen con las normativas locales sin sacrificar visibilidad." }
      ]
    },
    {
      slug: "poker-online",
      name: "Poker Online",
      icon: "🃏",
      description: "Atracción de jugadores de alto valor. Optimizamos portales y escuelas de poker para captar tráfico transaccional y fidelizar usuarios.",
      details: [
        { title: "Contenido de Intención", text: "Guías y comparativas que resuelven las dudas del jugador y lo guían hacia la conversión." },
        { title: "Estrategia de Afiliación", text: "Optimizamos tu arquitectura para maximizar el valor de cada usuario referido." }
      ]
    },
    {
      slug: "saas",
      name: "Saas",
      icon: "⚙️",
      description: "Sistemas de crecimiento para software como servicio. Reducimos tu CAC mediante la creación de una máquina de adquisición orgánica predecible.",
      details: [
        { title: "Product-Led SEO", text: "Posicionamos tu herramienta como la solución natural a los problemas de tus usuarios." },
        { title: "Autoridad Técnica", text: "Estrategias de contenido que atraen tanto a tomadores de decisiones como a usuarios finales." }
      ]
    },
    {
      slug: "ciber-seguridad",
      name: "Ciber Seguridad",
      icon: "🛡️",
      description: "Confianza blindada en el entorno digital. Posicionamos servicios de seguridad ante empresas que priorizan la integridad de sus datos.",
      details: [
        { title: "SEO de Autoridad B2B", text: "Contenido técnico que demuestra expertise y genera confianza en niveles ejecutivos (C-Level)." },
        { title: "Generación de Pipeline", text: "Estrategias enfocadas en captar cuentas Enterprise mediante búsquedas de alta intención." }
      ]
    },
    {
      slug: "investigacion-y-desarrollo",
      name: "Investigación y desarrollo",
      icon: "🔬",
      description: "Visibilidad para la innovación científica. Conectamos laboratorios y proyectos de I+D con socios, inversores y talento especializado.",
      details: [
        { title: "Divulgación Estratégica", text: "Optimizamos el alcance de tus hallazgos para atraer colaboraciones de alto impacto." },
        { title: "Ecosistema de Innovación", text: "Posicionamos tu centro como referente en el avance tecnológico y científico." }
      ]
    },
    {
      slug: "seguros",
      name: "Seguros",
      icon: "📜",
      description: "Protección a un clic de distancia. Estrategias de visibilidad para aseguradoras y corredurías en un mercado basado en la solvencia y la cercanía.",
      details: [
        { title: "Búsquedas de Decisión", text: "Comparativas y contenido informativo que guía al usuario hacia la póliza adecuada." },
        { title: "Captación Local", text: "Aseguramos que tu agencia sea la referencia para quienes buscan protección en su ciudad." }
      ]
    }
  ];

  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
---

<IndustryLayout
  industry={industry.name}
  description={industry.description}
  icon={industry.icon}
  details={industry.details}
/>
