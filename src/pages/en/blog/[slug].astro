---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../../data/sanity';
import { PortableText } from '@portabletext/react';
import { components } from './_PortableTextComponents';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && language == "en"]{ "slug": slug.current }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug },
  }));
}

const lang = 'en';
const { slug } = Astro.params;
const post = await sanityClient.fetch(`
  *[_type == "post" && slug.current == $slug && language == "en"][0]{
    ...,
    "author": select(
      author._type == "reference" => author-> {
        ...
      },
      author != null => *[_type == "author" && name == ^.author][0] {
        ...
      },
      null
    )
  }
`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const body = post.body;

const t = {
  blog: "Blog",
  written_by: "Written by",
  expert_profile: "View expert profile",
  about: "About",
  trajectory: "View my career",
  locale: "en-US"
};

// Lógica para detectar si es el autor principal para conectar con "Sobre Mí"
const isPrimaryAuthor = post.author?.name?.toLowerCase().includes('roberto');
const authorLink = isPrimaryAuthor ? '/en/sobre-mi' : `/en/autores/${post.author?.slug?.current}`;

// Esquema JSON-LD para EEAT
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "image": post.mainImage ? urlFor(post.mainImage).url() : "",
  "datePublished": post.publishedAt,
  "author": {
    "@type": "Person",
    "name": post.author?.name,
    "url": `https://www.robertoperezsalazar.com${authorLink}`,
    "jobTitle": post.author?.jobTitle
  }
};
---

<Layout
  title={`${post.title} | Blog Roberto Pérez Salazar`}
  description={post.title}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Navbar />

  <main class="pt-32">
    <article class="py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="mb-12 text-center md:text-left">
          <div class="flex items-center justify-center md:justify-start gap-4 mb-8 text-sm font-bold text-blue-600 uppercase tracking-widest">
            <a href={lang === 'es' ? "/blog" : "/en/blog"} class="hover:underline">{t.blog}</a>
            <span class="text-slate-300">•</span>
            <time>{new Date(post.publishedAt).toLocaleDateString(t.locale, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </div>

          <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-10 leading-tight">
            {post.title}
          </h1>

          {post.author && (
            <div class="flex flex-col md:flex-row items-center gap-6 py-8 border-y border-slate-100">
              <a href={authorLink} class="group flex items-center gap-4">
                {post.author.image ? (
                  <img
                    src={urlFor(post.author.image).width(150).height(150).url()}
                    alt={post.author.name}
                    class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-md group-hover:border-blue-600 transition-all"
                  />
                ) : (
                  <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-xl">
                    {post.author.name.substring(0, 2).toUpperCase()}
                  </div>
                )}
                <div class="text-left">
                  <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mb-1">{t.written_by}</p>
                  <p class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{post.author.name}</p>
                  <p class="text-sm text-slate-500">{post.author.jobTitle}</p>
                </div>
              </a>

              <div class="flex gap-4 md:ml-auto">
                 <a href={authorLink} class="text-xs font-bold py-2 px-6 rounded-full bg-slate-900 text-white hover:bg-blue-600 transition-all shadow-lg">
                   {t.expert_profile}
                 </a>
              </div>
            </div>
          )}
        </header>

        {post.mainImage && (
          <div class="mb-16 rounded-3xl overflow-hidden shadow-2xl">
            <img
              src={urlFor(post.mainImage).width(1200).url()}
              alt={post.title}
              class="w-full h-auto"
            />
          </div>
        )}

        <div class="prose prose-lg prose-slate max-w-none prose-headings:text-slate-900 prose-p:leading-relaxed prose-a:text-blue-600">
          <PortableText
              value={body}
              components={components}
              client:load
          />
        </div>

      </div>
    </article>
  </main>

  <Footer />
</Layout>
