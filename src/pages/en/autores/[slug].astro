---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../../data/sanity';
import BlogCard from '../../../components/BlogCard.jsx';

export async function getStaticPaths() {
  const authors = await sanityClient.fetch(`*[_type == "author" && language == "en"]{ "slug": slug.current }`);
  return authors.map((author: any) => ({
    params: { slug: author.slug },
  }));
}

const lang = 'en';
const { slug } = Astro.params;

// Traer datos del autor y sus posts relacionados
const data = await sanityClient.fetch(`
  *[_type == "author" && slug.current == $slug && language == "en"][0]{
    ...,
    "posts": *[_type == "post" && references(^._id) && language == "en"] | order(publishedAt desc)
  }
`, { slug });

if (!data) {
  return Astro.redirect('/404');
}

const t = {
  author_at: "Author at",
  published_by: "Articles published by",
  no_posts: "This author hasn't published any articles yet."
};
---

<Layout title={`${data.name} | ${t.author_at} Roberto Pérez Salazar`}>
  <Navbar />

  <main class="pt-32">
    <section class="py-20 bg-slate-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {data.image && (
          <div class="mb-8 inline-block">
            <img
              src={urlFor(data.image).width(200).height(200).url()}
              alt={data.name}
              class="w-32 h-32 md:w-48 md:h-32 rounded-full object-cover border-4 border-white shadow-xl mx-auto"
            />
          </div>
        )}
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">{data.name}</h1>
        <p class="text-blue-600 font-bold text-lg mb-6 uppercase tracking-widest">{data.jobTitle}</p>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed">
          {data.bio}
        </p>

        <div class="flex justify-center gap-6">
          {data.linkedin && (
            <a href={data.linkedin} target="_blank" class="text-slate-400 hover:text-blue-600 transition-colors">
              <span class="sr-only">LinkedIn</span>
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.732s.784-1.732 1.75-1.732 1.75.779 1.75 1.732-.784 1.732-1.75 1.732zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          )}
          {data.youtube && (
            <a href={data.youtube} target="_blank" class="text-slate-400 hover:text-red-600 transition-colors">
              <span class="sr-only">YouTube</span>
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-slate-900 mb-12">{t.published_by} {data.name.split(' ')[0]}</h2>

        {data.posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {data.posts.map((post: any) => (
              <BlogCard post={post} client:load />
            ))}
          </div>
        ) : (
          <p class="text-slate-500 italic">{t.no_posts}</p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
