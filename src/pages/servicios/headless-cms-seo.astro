---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const service = {
  title: "Headless CMS SEO",
  icon: "🏗️",
  description: "SEO técnico para la web moderna y desacoplada. Aseguramos que la libertad de desarrollo que ofrecen las arquitecturas Headless se traduzca en una indexabilidad perfecta y un rendimiento SEO insuperable.",
  details: [
    { title: "Orquestación de Metadatos", text: "Implementación de sistemas que garantizan la consistencia de etiquetas SEO en aplicaciones SPA y arquitecturas desacopladas." },
    { title: "Renderizado Estratégico", text: "Configuración de SSR y SSG para ofrecer el contenido de forma instantánea tanto a usuarios como a bots de búsqueda." }
  ],
  faqs: [
    {
      question: "¿Se puede crear una integración con Sanity CMS y la página web de tal manera que cuando se publique un post se autopublique en las redes sociales que uno en marque?",
      answer: "¡Absolutamente! Diseñamos e implementamos flujos de automatización personalizados utilizando webhooks de Sanity CMS conectados a plataformas de integración (como n8n, Make o scripts personalizados en Node.js/Python).\n\nAl momento de publicar o actualizar un artículo, el sistema procesa el contenido (pudiendo usar IA para adaptar los copys a cada formato de red social), detecta los canales seleccionados (LinkedIn, Twitter, Facebook, Instagram, etc.) y realiza la publicación automática de forma instantánea. Esto optimiza el tiempo de distribución de contenido y maximiza el alcance orgánico de cada publicación sin esfuerzo manual."
    }
  ]
};
---
<ServiceLayout {...service} />
