---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const service = {
  title: "Ai Growth Engineer",
  icon: "⚙️",
  description: "La intersección entre ingeniería de datos, inteligencia artificial y crecimiento de negocio. Diseñamos e implementamos sistemas inteligentes que automatizan la adquisición de clientes a escala.",
  details: [
    { title: "Orquestación de Agentes", text: "Desarrollo de pipelines inteligentes que conectan herramientas de IA para ejecutar tareas complejas de marketing de forma autónoma." },
    { title: "Escalado Inteligente", text: "Uso de modelos de lenguaje para generar, optimizar y distribuir contenido y estrategias que multiplican tu alcance sin aumentar tus costos operativos." }
  ],
  faqs: [
    {
      question: "¿Se puede crear una integración con Sanity CMS y la página web de tal manera que cuando se publique un post se autopublique en las redes sociales que uno enmarque?",
      answer: "¡Absolutamente! Diseñamos e implementamos flujos de automatización personalizados utilizando webhooks de Sanity CMS conectados a plataformas de integración (como n8n, Make o scripts personalizados en Node.js/Python).\n\nAl momento de publicar o actualizar un artículo, el sistema procesa el contenido (pudiendo usar IA para adaptar los copys a cada formato de red social), detecta los canales seleccionados (LinkedIn, Twitter, Facebook, Instagram, etc.) y realiza la publicación automática de forma instantánea. Esto optimiza el tiempo de distribución de contenido y maximiza el alcance orgánico de cada publicación sin esfuerzo manual."
    }
  ]
};
---
<ServiceLayout {...service} />
