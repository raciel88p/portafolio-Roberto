const service = {
  title: "SEO para Directorios",
  icon: "🗂️",
  description: "Optimizamos arquitecturas complejas de directorios y grandes volúmenes de datos para acelerar la indexación masiva en Google, mejorar la experiencia de usuario y capturar búsquedas de alta intención transaccional.",
  details: [
    { title: "Arquitectura de la Información", text: "Estructuramos de manera jerárquica y semántica las categorías y listados para facilitar el rastreo y la navegación." },
    { title: "Optimización de Indexación", text: "Estrategias avanzadas de enlazado interno y directivas de rastreo para asegurar que cada página de valor sea indexada." }
  ]
};
---
<ServiceLayout {...service} />
