---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": `Caso de Estudio: ${project.title}`,
  "description": project.description,
  "author": {
    "@type": "Person",
    "name": "Roberto Pérez Salazar"
  }
};
---

<Layout title={`Caso de Estudio: ${project.title} | Roberto Pérez Salazar`}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Navbar />

  <main class="pt-32">
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Hero Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-24">
          <div>
            <div class="inline-block px-4 py-1 rounded-full bg-blue-50 text-blue-600 text-sm font-bold mb-6 uppercase tracking-wider">
              {project.tag}
            </div>
            <div class="flex flex-col md:flex-row items-start md:items-center gap-8 mb-12">
              {project.logo && (
                <div class="w-48 h-48 md:w-56 md:h-56 flex-shrink-0 bg-white rounded-[2.5rem] p-4 shadow-xl border border-slate-100 flex items-center justify-center overflow-hidden">
                  <img src={project.logo} alt={`Logo de ${project.title}`} class="w-full h-full object-contain scale-125" />
                </div>
              )}
              <h1 class="text-4xl md:text-6xl font-bold text-slate-900 leading-tight">
                {project.title}
              </h1>
            </div>
            <p class="text-xl text-slate-600 mb-8 leading-relaxed">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-4">
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="bg-blue-600 text-white px-8 py-4 rounded-full font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-200 flex items-center">
                Visitar Sitio Web
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>
            </div>
          </div>
          <div class="relative group">
            <div class="absolute -inset-4 bg-blue-100 rounded-[3rem] rotate-2 group-hover:rotate-1 transition-transform"></div>
            <div class="relative rounded-[2.5rem] overflow-hidden shadow-2xl border-8 border-white">
              <img src={project.image} alt={project.title} class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

        <!-- Content Sections -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
          <div class="lg:col-span-2 space-y-20">
            {project.fullContent.company && (
              <div>
                <h2 class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-4">
                  {project.fullContent.companyTitle || "La Empresa"}
                </h2>
                <h3 class="text-3xl font-bold text-slate-900 mb-6 leading-tight">
                  {project.fullContent.companySub || "Expertise que genera confianza"}
                </h3>
                <div class="text-xl text-slate-600 leading-relaxed whitespace-pre-line">
                  {project.fullContent.company}
                </div>
              </div>
            )}

            {project.fullContent.challenge && (
              <div>
                <h2 class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-4">
                  {project.fullContent.challengeTitle || "El Desafío"}
                </h2>
                <h3 class="text-3xl font-bold text-slate-900 mb-6 leading-tight">
                  {project.fullContent.challengeSub || "El reto de escalar en un mercado saturado"}
                </h3>
                <div class="text-xl text-slate-600 leading-relaxed whitespace-pre-line">
                  {project.fullContent.challenge}
                </div>
              </div>
            )}

            {project.fullContent.solution && (
              <div>
                <h2 class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-4">
                  {project.fullContent.solutionTitle || "La Solución"}
                </h2>
                <h3 class="text-3xl font-bold text-slate-900 mb-6 leading-tight">
                  {project.fullContent.solutionSub || "Estrategia integrada y ejecución técnica"}
                </h3>
                <div class="text-xl text-slate-600 leading-relaxed whitespace-pre-line">
                  {project.fullContent.solution}
                </div>
              </div>
            )}

            {project.fullContent.steps && (
              <div class="space-y-12">
                {project.fullContent.steps.map((step, index) => (
                  <div class="relative pl-8 border-l-2 border-blue-100">
                    <div class="absolute -left-3 top-0 w-6 h-6 bg-blue-600 rounded-full border-4 border-white shadow-sm"></div>
                    <h4 class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-2">Paso 0{index + 1}</h4>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">{step.title}</h3>
                    <p class="text-lg text-slate-600 leading-relaxed">{step.content}</p>
                  </div>
                ))}
              </div>
            )}

            {!project.fullContent.steps && project.fullContent.strategy && (
              <div>
                <h2 class="text-3xl font-bold text-slate-900 mb-6 flex items-center">
                  <span class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm mr-4">02</span>
                  {project.fullContent.strategyTitle || "Nuestra Estrategia"}
                </h2>
                <div class="text-lg text-slate-600 leading-relaxed whitespace-pre-line">
                  {project.fullContent.strategy}
                </div>
              </div>
            )}

            {project.fullContent.experience && project.fullContent.experience.length > 0 && (
              <div>
                <h2 class="text-3xl font-bold text-slate-900 mb-6 flex items-center">
                  <span class="w-8 h-8 bg-blue-600 text-white rounded-lg flex items-center justify-center text-sm mr-4">03</span>
                  {project.fullContent.experienceTitle || "Experiencia Profesional"}
                </h2>
                <div class="bg-blue-50/50 rounded-3xl p-8 border border-blue-100">
                  <ul class="space-y-4">
                    {project.fullContent.experience.map(item => (
                      <li class="flex items-start text-lg text-slate-700 leading-relaxed">
                        <svg class="w-6 h-6 text-blue-600 mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}

            {project.fullContent.story && (
              <div class="bg-slate-900 text-white rounded-[3rem] p-12 shadow-2xl relative overflow-hidden">
                <div class="relative z-10">
                  <h2 class="text-xs font-bold text-blue-400 uppercase tracking-widest mb-4">
                    {project.fullContent.storyTitle || "La Historia Detrás"}
                  </h2>
                  <h3 class="text-3xl font-bold mb-8 leading-tight">
                    {project.fullContent.storySub || "Nuestra Trayectoria"}
                  </h3>
                  <div class="text-xl text-slate-300 leading-relaxed italic whitespace-pre-line">
                    "{project.fullContent.story}"
                  </div>
                </div>
                <!-- Decoration -->
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-blue-600/20 rounded-full blur-3xl"></div>
              </div>
            )}
          </div>

          <div class="lg:col-span-1">
            <div class="bg-slate-50 rounded-3xl p-8 sticky top-32">
              {project.fullContent.metrics && (
                <div class="grid grid-cols-2 gap-4 mb-10">
                  {project.fullContent.metrics.map(metric => (
                    <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
                      <div class="text-2xl font-bold text-blue-600">{metric.value}</div>
                      <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{metric.label}</div>
                    </div>
                  ))}
                </div>
              )}

              <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center">
                <svg class="w-6 h-6 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Resultados Clave
              </h2>
              <ul class="space-y-4">
                {project.fullContent.results.map(result => (
                  <li class="flex items-start text-slate-700">
                    <span class="text-blue-600 mr-2 font-bold">•</span>
                    {result}
                  </li>
                ))}
              </ul>

              {project.fullContent.quote && (
                <div class="mt-12 pt-8 border-t border-slate-200">
                  <p class="text-lg font-bold text-slate-900 leading-relaxed italic">
                    "{project.fullContent.quote}"
                  </p>
                </div>
              )}

              <div class="mt-12 pt-8 border-t border-slate-200">
                <p class="text-sm font-bold text-slate-900 mb-4 uppercase tracking-wider">¿Buscas resultados similares?</p>
                <a href="/#contacto" class="block w-full text-center bg-slate-900 text-white py-4 rounded-xl font-bold hover:bg-slate-800 transition-colors">
                  Agenda una Consultoría
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Navigation between projects -->
    <section class="py-20 border-t border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center">
                <a href="/proyectos" class="text-slate-600 font-bold hover:text-blue-600 transition-colors flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path></svg>
                    Volver a Proyectos
                </a>
            </div>
        </div>
    </section>
  </main>

  <Footer />
</Layout>
