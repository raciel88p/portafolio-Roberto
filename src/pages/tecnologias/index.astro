---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';

const techGroups = [
  {
    category: "Medición, Analítica y Toma de Decisiones",
    desc: "Infraestructura para transformar datos dispersos en decisiones de inversión claras y rentables.",
    tools: [
      { name: "Google Analytics 4", slug: "google-analytics-4", desc: "Modelos de atribución multicanal y seguimiento avanzado del recorrido del cliente." },
      { name: "Google Tag Manager", slug: "google-tag-manager", desc: "Gestión centralizada de eventos, conversiones y etiquetas de medición sin fricción técnica." },
      { name: "Looker Studio", slug: "looker", desc: "Paneles ejecutivos interactivos para el control de ingresos, costos de adquisición y KPIs." }
    ]
  },
  {
    category: "Automatización e Inteligencia Artificial",
    desc: "Sistemas inteligentes que eliminan tareas repetitivas y convierten la empresa en una operación 24/7.",
    tools: [
      { name: "Automatizaciones Agénticas", slug: "automatizaciones-agenticas", desc: "Agentes autónomos de IA que califican prospectos, gestionan clientes y coordinan flujos complejos." },
      { name: "Asistentes Agénticos", slug: "asistentes-agenticos", desc: "Copilotos especializados con contexto profundo para la toma de decisiones y atención comercial." },
      { name: "n8n", slug: "n8n", desc: "Motor de automatización de flujos de trabajo que conecta CRM, APIs y herramientas internas." },
      { name: "Python para Automatización", slug: "python", desc: "Scripts personalizados e Inteligencia Artificial para el procesamiento masivo de datos y auditorías." },
      { name: "GoHighLevel", slug: "gohighlevel", desc: "Plataforma unificada de CRM, embudos, secuencias de seguimiento y automatización comercial." }
    ]
  },
  {
    category: "SEO Técnico y Búsqueda en Motores Generativos (GEO/AEO)",
    desc: "Visibilidad constante en motores de búsqueda tradicionales y plataformas de Inteligencia Artificial.",
    tools: [
      { name: "SEO para WordPress", slug: "wordpress", desc: "Optimización especializada de velocidad, arquitectura y posicionamiento para entornos WordPress." },
      { name: "Webflow SEO & Gestión", slug: "webflow", desc: "Plataformas web de alto rendimiento, optimizadas para conversión y velocidad de carga extrema." },
      { name: "SEO para CMS Desacoplados", slug: "headless-cms", desc: "Arquitecturas Headless CMS rápidas, seguras y preparadas para posicionamiento masivo." }
    ]
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Infraestructura Tecnológica Orientada al Crecimiento Empresarial",
  "description": "Agrupación estratégica de tecnologías por objetivos de negocio: medición, automatización, Inteligencia Artificial y posicionamiento orgánico.",
  "provider": {
    "@type": "Person",
    "name": "Roberto Pérez Salazar"
  },
  "areaServed": "Global"
};
---

<Layout
  title="Tecnologías e Infraestructura de Crecimiento | Roberto Pérez Salazar"
  description="Herramientas y tecnologías seleccionadas para resolver problemas reales de negocio: Inteligencia Artificial, automatización, analítica y SEO."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Navbar />

  <main class="pt-24 bg-white text-slate-900">
    <!-- Hero Section -->
    <section class="relative py-20 md:py-28 bg-slate-50 border-b border-slate-100 overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <span class="inline-block px-4 py-1.5 text-xs font-bold bg-blue-100 text-blue-700 rounded-full uppercase tracking-wider mb-6">
          Infraestructura Tecnológica
        </span>
        <h1 class="text-4xl md:text-6xl font-black text-slate-900 leading-tight tracking-tight">
          La Tecnología es Únicamente el Medio. El Impacto en el Negocio es el Objetivo.
        </h1>
        <p class="text-xl md:text-2xl font-bold text-slate-600 mt-8 max-w-3xl mx-auto leading-relaxed">
          No implementamos herramientas por tendencia. Agrupamos tecnologías según el problema comercial que resuelven y el valor que generan.
        </p>
        <div class="mt-10">
          <a href="#contacto" class="inline-block bg-blue-600 text-white px-8 py-4 rounded-full font-bold hover:bg-blue-700 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
            Evaluar Arquitectura de su Empresa
          </a>
        </div>
      </div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full pointer-events-none opacity-40">
        <div class="absolute top-10 left-10 w-72 h-72 bg-blue-100 rounded-full mix-blend-multiply filter blur-3xl"></div>
        <div class="absolute bottom-10 right-10 w-72 h-72 bg-slate-200 rounded-full mix-blend-multiply filter blur-3xl"></div>
      </div>
    </section>

    <!-- Technology Groups Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
        {techGroups.map((group, idx) => (
          <div class="space-y-8">
            <div class="border-l-4 border-blue-600 pl-6">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">Categoría 0{idx + 1}</span>
              <h2 class="text-3xl font-black text-slate-900">{group.category}</h2>
              <p class="text-slate-600 text-base mt-2 max-w-2xl">{group.desc}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {group.tools.map((tool) => (
                <div class="p-6 bg-slate-50 border border-slate-200 rounded-2xl hover:border-blue-300 transition-all flex flex-col justify-between">
                  <div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">{tool.name}</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">{tool.desc}</p>
                  </div>

                  <div class="pt-4 border-t border-slate-200">
                    <a href={`/tecnologias/${tool.slug}`} class="inline-flex items-center text-xs font-bold text-blue-600 hover:text-blue-800 transition-colors">
                      Ver solución con {tool.name}
                      <svg class="w-3.5 h-3.5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Value Statement Section -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <h2 class="text-3xl md:text-4xl font-black">
          ¿Por qué Este Enfoque Tecnológico es Diferente?
        </h2>
        <p class="text-slate-300 text-lg max-w-2xl mx-auto leading-relaxed">
          La mayoría de las empresas terminan con herramientas desconectadas que generan duplicidad de datos y procesos manuales. Nuestro trabajo es construir un ecosistema unificado:
        </p>

        <div class="p-6 bg-slate-800 rounded-2xl border border-slate-700 font-bold text-blue-300 text-sm md:text-base max-w-xl mx-auto">
          Captación → Calificación → CRM → Automatización → Medición → Optimización
        </div>

        <p class="text-slate-400 text-sm">
          Toda herramienta integrada debe reducir costos, aumentar la productividad o acelerar los ingresos de la empresa.
        </p>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section id="contacto">
      <Contact />
    </section>
  </main>

  <Footer />
</Layout>
