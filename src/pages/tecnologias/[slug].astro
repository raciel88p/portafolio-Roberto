        { title: "Cloud Native", text: "Desarrollo de aplicaciones diseñadas específicamente para aprovechar la elasticidad de la nube." },
        { title: "DevOps & CI/CD", text: "Implementación de flujos de despliegue continuo para una entrega de software ágil." }
      ]
    },
  ];

  return technologies.map((tech) => ({
    params: { slug: tech.slug },
    props: { tech },
  }));
}

const { tech } = Astro.props;
---

<TechnologyLayout
  title={`${tech.name} - Tecnología | Roberto Pérez Salazar`}
  description={tech.description}
  icon={tech.icon}
  details={tech.details}
/>
