---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { sanityClient } from '../../../data/sanity';
import BlogCard from "../../../components/BlogCard.jsx";

export async function getStaticPaths() {
  const categories = await sanityClient.fetch(`*[_type == "category" && (language == "es" || !defined(language))]{ "slug": slug.current, title }`);
  return categories.map((cat: any) => ({
    params: { slug: cat.slug },
    props: { title: cat.title },
  }));
}

const { slug } = Astro.params;
const { title } = Astro.props;
const lang = 'es';

const posts = await sanityClient.fetch(
  `*[_type == "post" && (language == $lang || !defined(language)) && references(*[_type == "category" && slug.current == $slug]._id)] | order(publishedAt desc) {
    ...,
    "author": select(
      author._type == "reference" => author-> {
        name,
        image,
        jobTitle
      },
      author != null => *[_type == "author" && name == ^.author][0] {
        name,
        image,
        jobTitle
      },
      null
    ),
    "categories": categories[]->title
  }`,
  { lang, slug }
);
---

<Layout title={`Categoría: ${title} | Blog Roberto Pérez Salazar`}>
  <Navbar />

  <main class="pt-32">
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16">
            <a href="/blog" class="text-blue-600 font-bold mb-4 inline-block hover:underline">← Volver al Blog</a>
            <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-6">
                Artículos en <span class="text-blue-600">{title}</span>
            </h1>
        </div>

        {posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post: any) => (
              <BlogCard post={post} client:load />
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
            <p class="text-slate-500 text-lg">No se encontraron artículos en esta categoría.</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
