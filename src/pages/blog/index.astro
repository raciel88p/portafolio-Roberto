---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import BlogCard from "../../components/BlogCard.jsx";
import { Search } from "lucide-react";

const posts = await sanityClient.fetch(`*[_type == "post"] | order(publishedAt desc)`);
---

<Layout title="Blog | Roberto Pérez Salazar - Consultor SEO y Marketing Digital">
  <Navbar />

  <main class="pt-32">
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mb-16">
          <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-6 leading-tight">
            Blog: Estrategias de <span class="text-blue-600">SEO e Inteligencia Artificial</span>
          </h1>
          <p class="text-xl text-slate-600 leading-relaxed mb-8">
            Comparto mi experiencia y conocimientos sobre cómo escalar negocios digitales utilizando las últimas tendencias en SEO, IA Generativa y marketing estratégico.
          </p>

          {/* Barra de búsqueda con Lucide Icon */}
          <div class="relative max-w-md group">
            <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-blue-600 transition-colors">
              <Search size={20} client:load />
            </div>
            <input
              type="text"
              placeholder="Buscar artículos..."
              class="w-full pl-12 pr-4 py-4 bg-white border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-600 transition-all shadow-sm"
            />
          </div>
        </div>

        {posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post: any) => (
              <BlogCard post={post} client:load />
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
            <p class="text-slate-500 text-lg">Próximamente nuevos artículos. ¡Vuelve pronto!</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
