---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../data/sanity';
import { PortableText } from '@portabletext/react';
import { components } from './_PortableTextComponents';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post"]{ "slug": slug.current }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(`
  *[_type == "post" && slug.current == $slug][0]{
    ...,
    "author": author-> {
      name,
      slug,
      image,
      jobTitle,
      bio,
      linkedin,
      youtube
    }
  }
`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const body = post.body;

// Lógica para detectar si es el autor principal para conectar con "Sobre Mí"
const isPrimaryAuthor = post.author?.name?.toLowerCase().includes('roberto');
const authorLink = isPrimaryAuthor ? '/sobre-mi' : `/autores/${post.author?.slug?.current}`;
---

<Layout
  title={`${post.title} | Blog Roberto Pérez Salazar`}
  description={post.title}
>
  <Navbar />

  <main class="pt-32">
    <article class="py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="mb-12 text-center md:text-left">
          <div class="flex items-center justify-center md:justify-start gap-4 mb-8 text-sm font-bold text-blue-600 uppercase tracking-widest">
            <a href="/blog" class="hover:underline">Blog</a>
            <span class="text-slate-300">•</span>
            <time>{new Date(post.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </div>

          <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-10 leading-tight">
            {post.title}
          </h1>

          {post.author && (
            <div class="flex flex-col md:flex-row items-center gap-6 py-8 border-y border-slate-100">
              <a href={authorLink} class="group flex items-center gap-4">
                {post.author.image ? (
                  <img
                    src={urlFor(post.author.image).width(150).height(150).url()}
                    alt={post.author.name}
                    class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-md group-hover:border-blue-600 transition-all"
                  />
                ) : (
                  <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-xl">
                    {post.author.name.substring(0, 2).toUpperCase()}
                  </div>
                )}
                <div class="text-left">
                  <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mb-1">Escrito por</p>
                  <p class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{post.author.name}</p>
                  <p class="text-sm text-slate-500">{post.author.jobTitle}</p>
                </div>
              </a>

              <div class="flex gap-4 md:ml-auto">
                 <a href={authorLink} class="text-xs font-bold py-2 px-4 rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all">
                   Ver perfil completo
                 </a>
              </div>
            </div>
          )}
        </header>

        {post.mainImage && (
          <div class="mb-16 rounded-3xl overflow-hidden shadow-2xl">
            <img
              src={urlFor(post.mainImage).width(1200).url()}
              alt={post.title}
              class="w-full h-auto"
            />
          </div>
        )}

        <div class="prose prose-lg prose-slate max-w-none prose-headings:text-slate-900 prose-p:leading-relaxed prose-a:text-blue-600">
          <PortableText
              value={body}
              components={components}
              client:load
          />
        </div>

        {/* Caja de autor optimizada con conexión a About */}
        {post.author && (
          <footer class="mt-24 pt-10 border-t border-slate-100">
            <div class="bg-slate-50 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center md:items-start gap-10">
              {post.author.image && (
                <div className="relative">
                    <img
                      src={urlFor(post.author.image).width(200).height(200).url()}
                      alt={post.author.name}
                      class="w-32 h-32 rounded-full object-cover shadow-2xl border-4 border-white"
                    />
                    <div class="absolute -bottom-2 -right-2 bg-blue-600 text-white p-2 rounded-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                </div>
              )}
              <div class="flex-1 text-center md:text-left">
                <h3 class="text-2xl font-bold text-slate-900 mb-2">Acerca de {post.author.name}</h3>
                <p class="text-blue-600 font-bold text-sm mb-6 uppercase tracking-widest">{post.author.jobTitle}</p>
                <p class="text-slate-600 mb-8 leading-relaxed text-lg italic">
                  "{post.author.bio}"
                </p>
                <div class="flex flex-wrap justify-center md:justify-start gap-6">
                  <a href={authorLink} class="inline-flex items-center font-bold text-blue-600 hover:text-blue-800 transition-colors group text-lg">
                    Conoce más sobre mi trayectoria
                    <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                  </a>
                </div>
              </div>
            </div>

            <div class="mt-16 bg-blue-600 rounded-[2.5rem] p-10 md:p-16 text-center text-white shadow-2xl shadow-blue-200 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -mr-32 -mt-32 blur-3xl"></div>
              <div class="relative z-10">
                <h3 class="text-3xl md:text-4xl font-bold mb-6">¿Buscas resultados reales para tu negocio?</h3>
                <p class="text-blue-50 mb-10 max-w-2xl mx-auto text-xl opacity-90 leading-relaxed">
                  Utilizo estrategias de SEO avanzado e Inteligencia Artificial para posicionar tu marca donde tus clientes están buscando hoy.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="/#contacto" class="bg-white text-blue-600 px-10 py-5 rounded-full font-bold hover:bg-blue-50 transition-all shadow-lg text-lg">
                      Trabajemos Juntos
                    </a>
                    <a href="/proyectos" class="bg-blue-700 text-white px-10 py-5 rounded-full font-bold hover:bg-blue-800 transition-all border border-blue-500/30 text-lg">
                      Ver Casos de Éxito
                    </a>
                </div>
              </div>
            </div>
          </footer>
        )}
      </div>
    </article>
  </main>

  <Footer />
</Layout>
