---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../data/sanity';
import { PortableText } from '@portabletext/react';
import { components } from './_PortableTextComponents';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post"]{ "slug": slug.current }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(`
  *[_type == "post" && slug.current == $slug][0]{
    ...,
    "author": author-> {
      name,
      slug,
      image,
      jobTitle,
      bio,
      linkedin,
      youtube
    }
  }
`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const body = post.body;
---

<Layout
  title={`${post.title} | Blog Roberto Pérez Salazar`}
  description={post.title}
>
  <Navbar />

  <main class="pt-32">
    <article class="py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="mb-12">
          <div class="flex items-center gap-4 mb-6 text-sm font-bold text-blue-600 uppercase tracking-widest">
            <a href="/blog" class="hover:underline">Blog</a>
            <span class="text-slate-300">•</span>
            <time>{new Date(post.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </div>
          <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-8 leading-tight">
            {post.title}
          </h1>

          {post.author && (
            <div class="flex items-center gap-4 py-6 border-y border-slate-100">
              <a href={`/autores/${post.author.slug.current}`} class="group flex items-center gap-4">
                {post.author.image ? (
                  <img
                    src={urlFor(post.author.image).width(100).height(100).url()}
                    alt={post.author.name}
                    class="w-12 h-12 rounded-full object-cover border-2 border-transparent group-hover:border-blue-600 transition-all"
                  />
                ) : (
                  <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold">
                    {post.author.name.substring(0, 2).toUpperCase()}
                  </div>
                )}
                <div>
                  <p class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{post.author.name}</p>
                  <p class="text-xs text-slate-500">{post.author.jobTitle}</p>
                </div>
              </a>
            </div>
          )}
        </header>

        {post.mainImage && (
          <div class="mb-12 rounded-3xl overflow-hidden shadow-2xl">
            <img
              src={urlFor(post.mainImage).width(1200).url()}
              alt={post.title}
              class="w-full h-auto"
            />
          </div>
        )}

        <div class="prose prose-lg prose-slate max-w-none">
          <PortableText
              value={body}
              components={components}
              client:load
          />
        </div>

        {/* Caja de autor al final del post */}
        {post.author && (
          <footer class="mt-20 pt-10 border-t border-slate-100">
            <div class="bg-slate-50 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center md:items-start gap-8">
              {post.author.image && (
                <img
                  src={urlFor(post.author.image).width(200).height(200).url()}
                  alt={post.author.name}
                  class="w-24 h-24 rounded-full object-cover shadow-lg"
                />
              )}
              <div class="flex-1 text-center md:text-left">
                <h3 class="text-2xl font-bold text-slate-900 mb-2">Sobre {post.author.name}</h3>
                <p class="text-blue-600 font-bold text-sm mb-4 uppercase tracking-widest">{post.author.jobTitle}</p>
                <p class="text-slate-600 mb-6 leading-relaxed">
                  {post.author.bio}
                </p>
                <div class="flex justify-center md:justify-start gap-4">
                  <a href={`/autores/${post.author.slug.current}`} class="text-sm font-bold text-blue-600 hover:text-blue-700 transition-colors">
                    Ver todos sus artículos →
                  </a>
                </div>
              </div>
            </div>

            <div class="mt-12 bg-blue-600 rounded-3xl p-8 md:p-12 text-center text-white shadow-xl shadow-blue-200">
              <h3 class="text-2xl font-bold mb-4">¿Te gustó este artículo?</h3>
              <p class="text-blue-50 mb-8 max-w-2xl mx-auto text-lg opacity-90">
                Optimizo tu presencia online para que los modelos de IA y buscadores prefieran tu contenido.
              </p>
              <a href="/#contacto" class="inline-block bg-white text-blue-600 px-8 py-4 rounded-full font-bold hover:bg-blue-50 transition-all shadow-lg">
                Hablemos de tu proyecto
              </a>
            </div>
          </footer>
        )}
      </div>
    </article>
  </main>

  <Footer />
</Layout>
