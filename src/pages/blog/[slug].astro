---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../data/sanity';
import { PortableText } from '@portabletext/react';
import { components } from './PortableTextComponents';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post"]{ "slug": slug.current }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(`*[_type == "post" && slug.current == $slug][0]`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const body = post.body;
---

<Layout
  title={`${post.title} | Blog Roberto Pérez Salazar`}
  description={post.title}
>
  <Navbar />

  <main class="pt-32">
    <article class="py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="mb-12">
          <div class="flex items-center gap-4 mb-6 text-sm font-bold text-blue-600 uppercase tracking-widest">
            <a href="/blog" class="hover:underline">Blog</a>
            <span class="text-slate-300">•</span>
            <time>{new Date(post.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </div>
          <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-8 leading-tight">
            {post.title}
          </h1>
          <div class="flex items-center gap-4 py-6 border-y border-slate-100">
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold">
              RP
            </div>
            <div>
              <p class="text-sm font-bold text-slate-900">Roberto Pérez Salazar</p>
              <p class="text-xs text-slate-500">Consultor SEO y Marketing Digital</p>
            </div>
          </div>
        </header>

        {post.mainImage && (
          <div class="mb-12 rounded-3xl overflow-hidden shadow-2xl">
            <img
              src={urlFor(post.mainImage).width(1200).url()}
              alt={post.title}
              class="w-full h-auto"
            />
          </div>
        )}

        <div class="prose prose-lg prose-slate max-w-none">
          <PortableText
              value={body}
              components={components}
              client:load
          />
        </div>

        <footer class="mt-20 pt-10 border-t border-slate-100">
          <div class="bg-blue-50 rounded-3xl p-8 md:p-12 text-center">
            <h3 class="text-2xl font-bold text-slate-900 mb-4">¿Necesitas ayuda con tu estrategia digital?</h3>
            <p class="text-slate-600 mb-8 max-w-2xl mx-auto text-lg">
              Optimizo tu presencia online para que los modelos de IA y buscadores prefieran tu contenido.
            </p>
            <a href="/#contacto" class="inline-block bg-blue-600 text-white px-8 py-4 rounded-full font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-200">
              Hablemos de tu proyecto
            </a>
          </div>
        </footer>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
