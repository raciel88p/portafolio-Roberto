---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../data/sanity';
import { PortableText } from '@portabletext/react';
import { components } from './_PortableTextComponents';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && (language == "es" || !defined(language))]{ "slug": slug.current }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug },
  }));
}

const lang = 'es';
const { slug } = Astro.params;
const post = await sanityClient.fetch(`
  *[_type == "post" && slug.current == $slug && (language == $lang || !defined(language))][0]{
    ...,
    "author": select(
      author._type == "reference" => author-> {
        ...
      },
      author != null => {
        "name": author,
        "jobTitle": "Consultor SEO",
        "bio": "Consultor especializado en SEO y Marketing Digital."
      },
      null
    )
  }
`, { slug, lang });

if (!post) {
  return Astro.redirect('/404');
}

const body = post.body;

const t = {
  blog: "Blog",
  written_by: "Escrito por",
  expert_profile: "Ver perfil de experto",
  about: "Acerca de",
  trajectory: "Conoce mi trayectoria",
  locale: "es-ES"
};

// Lógica para detectar si es el autor principal para conectar con "Sobre Mí"
const isPrimaryAuthor = post.author?.name?.toLowerCase().includes('roberto');
const authorLink = isPrimaryAuthor ? '/sobre-mi' : `/autores/${post.author?.slug?.current}`;

// Esquema JSON-LD para EEAT
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "image": post.mainImage ? urlFor(post.mainImage).url() : "",
  "datePublished": post.publishedAt,
  "author": {
    "@type": "Person",
    "name": post.author?.name,
    "url": `https://www.robertoperezsalazar.com${authorLink}`,
    "jobTitle": post.author?.jobTitle
  }
};
---

<Layout
  title={`${post.title} | Blog Roberto Pérez Salazar`}
  description={post.title}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Navbar />

  <main class="pt-32">
    <article class="py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="mb-12 text-center md:text-left">
          <div class="flex items-center justify-center md:justify-start gap-4 mb-8 text-sm font-bold text-blue-600 uppercase tracking-widest">
            <a href={lang === 'es' ? "/blog" : "/en/blog"} class="hover:underline">{t.blog}</a>
            <span class="text-slate-300">•</span>
            <time>{new Date(post.publishedAt).toLocaleDateString(t.locale, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </div>

          <h1 class="text-4xl md:text-6xl font-bold text-slate-900 mb-10 leading-tight">
            {post.title}
          </h1>

          {post.author && (
            <div class="flex flex-col md:flex-row items-center gap-6 py-8 border-y border-slate-100">
              <a href={authorLink} class="group flex items-center gap-4">
                {post.author.image ? (
                  <img
                    src={urlFor(post.author.image).width(150).height(150).url()}
                    alt={post.author.name}
                    class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-md group-hover:border-blue-600 transition-all"
                  />
                ) : (
                  <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-xl">
                    {post.author.name.substring(0, 2).toUpperCase()}
                  </div>
                )}
                <div class="text-left">
                  <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mb-1">{t.written_by}</p>
                  <p class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{post.author.name}</p>
                  <p class="text-sm text-slate-500">{post.author.jobTitle}</p>
                </div>
              </a>

              <div class="flex gap-4 md:ml-auto">
                 <a href={authorLink} class="text-xs font-bold py-2 px-6 rounded-full bg-slate-900 text-white hover:bg-blue-600 transition-all shadow-lg">
                   {t.expert_profile}
                 </a>
              </div>
            </div>
          )}
        </header>

        {post.mainImage && (
          <div class="mb-16 rounded-3xl overflow-hidden shadow-2xl">
            <img
              src={urlFor(post.mainImage).width(1200).url()}
              alt={post.title}
              class="w-full h-auto"
            />
          </div>
        )}

        <div class="prose prose-lg prose-slate max-w-none prose-headings:text-slate-900 prose-p:leading-relaxed prose-a:text-blue-600">
          <PortableText
              value={body}
              components={components}
              client:load
          />
        </div>

        {/* Caja de autor optimizada para EEAT */}
        {post.author && (
          <footer class="mt-24 pt-10 border-t border-slate-100">
            <div class="bg-slate-50 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center md:items-start gap-10 border border-slate-100 shadow-sm">
              {post.author.image && (
                <div class="relative">
                    <img
                      src={urlFor(post.author.image).width(200).height(200).url()}
                      alt={post.author.name}
                      class="w-32 h-32 rounded-full object-cover shadow-2xl border-4 border-white"
                    />
                    <div class="absolute -bottom-2 -right-2 bg-blue-600 text-white p-2 rounded-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                </div>
              )}
              <div class="flex-1 text-center md:text-left">
                <h3 class="text-2xl font-bold text-slate-900 mb-2">{t.about} {post.author.name}</h3>
                <p class="text-blue-600 font-bold text-sm mb-4 uppercase tracking-widest">{post.author.jobTitle}</p>
                <p class="text-slate-600 mb-8 leading-relaxed text-lg">
                  {post.author.bio}
                </p>

                <div class="flex flex-wrap justify-center md:justify-start gap-4 items-center">
                  <a href={authorLink} class="inline-flex items-center font-bold text-slate-900 hover:text-blue-600 transition-colors group">
                    {t.trajectory}
                    <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                  </a>
                  <span class="text-slate-300 hidden md:block">|</span>
                  <div class="flex gap-4">
                    {post.author.linkedin && (
                      <a href={post.author.linkedin} target="_blank" class="text-slate-400 hover:text-blue-600 transition-colors">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.732s.784-1.732 1.75-1.732 1.75.779 1.75 1.732-.784 1.732-1.75 1.732zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                      </a>
                    )}
                    {post.author.youtube && (
                      <a href={post.author.youtube} target="_blank" class="text-slate-400 hover:text-red-600 transition-colors">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </footer>
        )}
      </div>
    </article>
  </main>

  <Footer />
</Layout>
